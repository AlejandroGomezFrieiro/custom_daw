<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.4.0">
  <!-- Keyswitches enable one group each, as the guide's examples do. -->
  <groups>
    <group name="Sustain"><sample path="s.wav" loNote="48" hiNote="84"/></group>
    <group name="Spiccato" enabled="false"><sample path="p.wav" loNote="48" hiNote="84"/></group>
    <group name="Harmonics" enabled="false"><sample path="h.wav" loNote="60" hiNote="96"/></group>
  </groups>
  <midi>
    <note note="24">
      <binding type="general" level="group" position="0" parameter="ENABLED" translation="fixed_value" translationValue="true"/>
      <binding type="general" level="group" position="1" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
      <binding type="general" level="group" position="2" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
    </note>
    <note note="25">
      <binding type="general" level="group" position="0" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
      <binding type="general" level="group" position="1" parameter="ENABLED" translation="fixed_value" translationValue="true"/>
      <binding type="general" level="group" position="2" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
    </note>
    <note note="26">
      <binding type="general" level="group" groupIndex="0" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
      <binding type="general" level="group" groupIndex="1" parameter="ENABLED" translation="fixed_value" translationValue="false"/>
      <binding type="general" level="group" groupIndex="2" parameter="ENABLED" translation="fixed_value" translationValue="true"/>
    </note>
  </midi>
</DecentSampler>
