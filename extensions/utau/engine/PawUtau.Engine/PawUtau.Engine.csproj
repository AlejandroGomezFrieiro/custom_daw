<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>paw-utau-engine</AssemblyName>
    <RootNamespace>PawUtau.Engine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PawUtau.Protocol/PawUtau.Protocol.csproj" />
    <ProjectReference Include="../../third_party/OpenUtau/OpenUtau.Core/OpenUtau.Core.csproj" />
    <ProjectReference Include="../../third_party/OpenUtau/OpenUtau.Plugin.Builtin/OpenUtau.Plugin.Builtin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The submodule's prebuilt worldline (the nixpkgs 0.1.565 .so is ABI-incompatible with 0.1.576). -->
    <!-- PawUtauNoWorldline=true leaves it out of the build. -->
    <None Include="../../third_party/OpenUtau/runtimes/linux-x64/native/libworldline.so" Link="libworldline.so" CopyToOutputDirectory="PreserveNewest" Condition="'$(PawUtauNoWorldline)' != 'true'" />
  </ItemGroup>
</Project>
