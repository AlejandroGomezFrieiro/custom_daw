// A window for a view that paints: an extension's own editor, drawn by its
// Lua in the kernel as rectangles, text, lines and music glyphs, made into
// one image by the rasterizer the terminal uses (crates/daw-raster), with
// the pointer and the keyboard passed back to it. A view drawn in cells is
// drawn here item by item, rectangles and runs of the window's monospace
// font. See `daw.canvas`.

import { Theme } from "widgets.slint";

export struct CanvasItem {
    kind: int,          // 0 rectangle, 3 a run of monospace cells
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    fill: color,        // a run's text
    stroke: color,      // a run's background
    stroke-width: length,
    radius: length,
    bold: bool,
    italic: bool,       // a run's attributes
    underline: bool,
    strike: bool,
}

export component CanvasWindow inherits Window {
    in property <string> name;
    in property <string> heading;
    in property <[CanvasItem]> items;
    // A painted view's drawing, at the screen's scale.
    in property <image> raster;
    title: root.heading;
    out property <length> canvas-width: self.width;
    out property <length> canvas-height: self.height;
    // The monospace font a view drawn in cells is drawn in, and the size of
    // one of its cells, measured on the font itself so that box-drawing
    // characters meet from one cell to the next.
    in property <length> mono-size: 13px;
    out property <length> cell-width: probe.preferred-width / 20;
    out property <length> cell-height: probe.preferred-height;
    // kind (0 down, 1 up, 2 move with a button held, 3 double, 4 hover), x, y, button (0 left, 1 right, 2 middle), ctrl, shift, alt
    callback pointer(int, length, length, int, bool, bool, bool);
    callback wheel(length, length, length, length, bool, bool);
    callback key(string, bool, bool, bool);
    preferred-width: 960px;
    preferred-height: 560px;
    min-width: 480px;
    min-height: 280px;
    background: Theme.surface;
    default-font-family: "Inter";
    default-font-size: 12px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
    }
    probe := Text {
        visible: false;
        text: "MMMMMMMMMMMMMMMMMMMM";
        font-family: "JetBrains Mono";
        font-size: root.mono-size;
    }
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.raster;
        image-fit: fill;
    }
    for item in root.items: Rectangle {
        x: item.x;
        y: item.y;
        width: item.w;
        height: item.h;
        if item.kind == 0: Rectangle {
            background: item.fill;
            border-color: item.stroke;
            border-width: item.stroke.alpha > 0 ? item.stroke-width : 0px;
            border-radius: item.radius;
        }
        if item.kind == 3: Rectangle {
            background: item.stroke;
            Text {
                x: 0;
                y: 0;
                // The run's last glyph may reach a fraction past its cells.
                width: parent.width + 4px;
                height: parent.height;
                text: item.text;
                color: item.fill;
                font-family: "JetBrains Mono";
                font-size: root.mono-size;
                font-weight: item.bold ? 700 : 400;
                font-italic: item.italic;
                wrap: no-wrap;
                overflow: clip;
            }
            if item.underline: Rectangle {
                y: parent.height - 2px;
                height: 1px;
                background: item.fill;
            }
            if item.strike: Rectangle {
                y: parent.height / 2;
                height: 1px;
                background: item.fill;
            }
        }
    }
    touch := TouchArea {
        // Held by any button: `pressed` is only the left one, and a right
        // drag moves too.
        property <bool> held;
        pointer-event(event) => {
            // Moving over the window with no button down is a hover.
            if (event.kind == PointerEventKind.move && !self.held && !self.pressed) {
                root.pointer(4, self.mouse-x, self.mouse-y, 0, false, false, false);
            }
            if (event.kind != PointerEventKind.move) {
                keys.focus();
            }
            if (event.kind == PointerEventKind.down) {
                self.held = true;
                root.pointer(0, self.mouse-x, self.mouse-y,
                    event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 0,
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            }
            if (event.kind == PointerEventKind.up) {
                self.held = false;
                root.pointer(1, self.mouse-x, self.mouse-y,
                    event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 0,
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            }
        }
        moved => {
            if (self.pressed || self.held) {
                root.pointer(2, self.mouse-x, self.mouse-y, 0, false, false, false);
            }
        }
        double-clicked => {
            root.pointer(3, self.mouse-x, self.mouse-y, 0, false, false, false);
        }
        scroll-event(event) => {
            root.wheel(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y, event.modifiers.control, event.modifiers.shift);
            accept
        }
    }
}
