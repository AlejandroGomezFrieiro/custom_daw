// A window for a view that paints: an extension's own editor, drawn by its
// Lua in the kernel as rectangles, text, lines and music glyphs, made into
// one image by the rasterizer the terminal uses (crates/daw-raster), with
// the pointer and the keyboard passed back to it. A view drawn in cells is
// drawn here item by item, rectangles and runs of the window's monospace
// font. See `daw.canvas`.

import { Theme, Button } from "widgets.slint";

export struct CanvasItem {
    kind: int,          // 0 rectangle, 3 a run of monospace cells
    x: length,
    y: length,
    w: length,
    h: length,
    text: string,
    fill: color,        // a run's text
    stroke: color,      // a run's background
    stroke-width: length,
    radius: length,
    bold: bool,
    italic: bool,       // a run's attributes
    underline: bool,
    strike: bool,
}

export component CanvasWindow inherits Window {
    in property <string> name;
    in property <string> heading;
    in property <[CanvasItem]> items;
    // A painted view's drawing, at the screen's scale.
    in property <image> raster;
    // The main window's mode and its status line as one line under the
    // view, as under the docked panes: the prompt, a message, or the keys.
    in property <string> mode: "n";
    in property <string> mode-name: "NORMAL";
    in property <string> line;
    in property <int> line-level;   // 0 plain, 1 a warning, 2 an error, 3 the keys
    title: root.heading;
    // The view is drawn under a title like a pane's, inset from the edges.
    property <length> heading-h: 28px;
    property <length> status-h: 22px;
    property <length> pad: 6px;
    out property <length> canvas-width: max(1px, self.width - 2 * self.pad);
    // A view drawn in cells draws a title row of its own, hidden under the
    // window's title.
    in property <bool> cells;
    property <length> under: self.cells ? self.cell-height : 0px;
    // The inset above the view: none for a view in cells, whose own title
    // row is the room there.
    property <length> pad-top: self.cells ? 0px : self.pad;
    out property <length> canvas-height: max(1px, self.height - self.heading-h - self.status-h - self.pad - self.pad-top + self.under);
    // The monospace font a view drawn in cells is drawn in, and the size of
    // one of its cells, measured on the font itself so that box-drawing
    // characters meet from one cell to the next.
    in property <length> mono-size: 13px;
    out property <length> cell-width: probe.preferred-width / 20;
    out property <length> cell-height: probe.preferred-height;
    // kind (0 down, 1 up, 2 move with a button held, 3 double, 4 hover), x, y, button (0 left, 1 right, 2 middle), ctrl, shift, alt
    callback pointer(int, length, length, int, bool, bool, bool);
    callback wheel(length, length, length, length, bool, bool);
    callback key(string, bool, bool, bool);
    // Back into the main window, as a pane.
    callback dock();
    preferred-width: 960px;
    preferred-height: 560px;
    min-width: 480px;
    min-height: 280px;
    background: Theme.surface;
    default-font-family: "Inter";
    default-font-size: 12px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
    }
    probe := Text {
        visible: false;
        text: "MMMMMMMMMMMMMMMMMMMM";
        font-family: "JetBrains Mono";
        font-size: root.mono-size;
    }
    Rectangle {
        x: root.pad;
        y: root.heading-h + root.pad-top - root.under;
        width: root.canvas-width;
        height: root.canvas-height;
        clip: true;
        Image {
            x: 0;
            y: 0;
            width: root.canvas-width;
            height: root.canvas-height;
            source: root.raster;
            image-fit: fill;
        }
        for item in root.items: Rectangle {
            x: item.x;
            y: item.y;
            width: item.w;
            height: item.h;
            if item.kind == 0: Rectangle {
                background: item.fill;
                border-color: item.stroke;
                border-width: item.stroke.alpha > 0 ? item.stroke-width : 0px;
                border-radius: item.radius;
            }
            if item.kind == 3: Rectangle {
                background: item.stroke;
                Text {
                    x: 0;
                    y: 0;
                    // The run's last glyph may reach a fraction past its cells.
                    width: parent.width + 4px;
                    height: parent.height;
                    text: item.text;
                    color: item.fill;
                    font-family: "JetBrains Mono";
                    font-size: root.mono-size;
                    font-weight: item.bold ? 700 : 400;
                    font-italic: item.italic;
                    wrap: no-wrap;
                    overflow: clip;
                }
                if item.underline: Rectangle {
                    y: parent.height - 2px;
                    height: 1px;
                    background: item.fill;
                }
                if item.strike: Rectangle {
                    y: parent.height / 2;
                    height: 1px;
                    background: item.fill;
                }
            }
        }
        touch := TouchArea {
            // Held by any button: `pressed` is only the left one, and a right
            // drag moves too.
            property <bool> held;
            pointer-event(event) => {
                // Moving over the window with no button down is a hover.
                if (event.kind == PointerEventKind.move && !self.held && !self.pressed) {
                    root.pointer(4, self.mouse-x, self.mouse-y, 0, false, false, false);
                }
                if (event.kind != PointerEventKind.move) {
                    keys.focus();
                }
                if (event.kind == PointerEventKind.down) {
                    self.held = true;
                    root.pointer(0, self.mouse-x, self.mouse-y,
                        event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 0,
                        event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                }
                if (event.kind == PointerEventKind.up) {
                    self.held = false;
                    root.pointer(1, self.mouse-x, self.mouse-y,
                        event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 0,
                        event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                }
            }
            moved => {
                if (self.pressed || self.held) {
                    root.pointer(2, self.mouse-x, self.mouse-y, 0, false, false, false);
                }
            }
            double-clicked => {
                root.pointer(3, self.mouse-x, self.mouse-y, 0, false, false, false);
            }
            scroll-event(event) => {
                root.wheel(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y, event.modifiers.control, event.modifiers.shift);
                accept
            }
        }
    }
    // The title, over the top of the view.
    Rectangle {
        x: 0;
        y: 0;
        height: root.heading-h;
        background: Theme.panel-sel;
        Text {
            x: 10px;
            width: parent.width - 100px;
            text: root.heading;
            color: Theme.text;
            font-size: Theme.t-small;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 6px;
            y: 4px;
            height: parent.height - 8px;
            Button {
                width: 64px;
                height: 20px;
                label: "Dock";
                tip: "back into the main window, as a pane (Ctrl-w d)";
                quiet: true;
                clicked => {
                    root.dock();
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.divider;
        }
    }
    // The status line.
    Rectangle {
        x: 0;
        y: root.height - root.status-h;
        height: root.status-h;
        background: Theme.panel;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: label.preferred-width + 12px;
                    height: 16px;
                    border-radius: 3px;
                    background: Theme.mode-color(root.mode);
                    label := Text {
                        text: root.mode-name;
                        color: Theme.on-hue;
                        font-weight: 600;
                        font-size: Theme.t-micro;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.line;
                color: root.line-level == 2 ? Theme.error : root.line-level == 1 ? Theme.warn : root.line-level == 3 ? Theme.text-2 : Theme.text;
                font-size: Theme.t-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
