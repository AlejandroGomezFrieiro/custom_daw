export component Icon inherits Rectangle {
    in property <string> shape;
    in property <color> ink: Theme.text;
    // The side of the box `shape` is drawn in: 16 for the drawings above,
    // 256 for Phosphor's.
    in property <float> box: 16;
    width: 16px;
    height: 16px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.box;
        viewbox-height: root.box;
        commands: root.shape;
        fill: root.ink;
    }
}

// A button with a drawing, a word, or both. `on` lights it in `lit`.
// A quiet button has no face until the pointer is on it, as the buttons of
// a toolbar; the others have the face of a control.
export component Button inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <float> icon-box: 16;
    in property <string> tip;
    in property <bool> on;
    in property <color> lit: Theme.select;
    in property <bool> quiet;   // no face until the pointer is on it
    in property <bool> enabled: true;
    in property <color> idle-ink: transparent;   // the drawing's colour while off, if not the usual
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    height: 28px;
    min-width: self.height;
    horizontal-stretch: 0;
    border-radius: self.height <= 22px ? 3px : 4px;
    background: !root.enabled ? (root.quiet ? transparent : Theme.control-press)
        : root.quiet ? (touch.pressed ? Theme.press-face : root.on ? root.lit.with-alpha(0.12) : touch.has-hover ? Theme.hover-face : transparent)
        : touch.pressed ? Theme.control-press : root.on ? root.lit.with-alpha(0.2) : touch.has-hover ? Theme.control-hover : Theme.control;
    animate background { duration: 80ms; }
    HorizontalLayout {
        padding-left: root.label == "" ? 0px : 8px;
        padding-right: root.label == "" ? 0px : 10px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: root.height <= 22px ? 14px : 16px;
                height: self.width;
                shape: root.icon;
                box: root.icon-box;
                ink: !root.enabled ? Theme.text-off : root.on ? root.lit : root.idle-ink.alpha > 0 ? (touch.has-hover ? root.idle-ink.brighter(0.25) : root.idle-ink) : touch.has-hover || !root.quiet ? Theme.text : Theme.text-2;
            }
        }
        if root.label != "": Text {
            text: root.label;
            color: !root.enabled ? Theme.text-off : root.on && root.quiet ? root.lit : Theme.text;
            font-size: Theme.t-base;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The small lettered switches of a track: mute, solo, arm. Off they are a
// plain control with a dim letter; on, the state's colour with a dark one.
export component Flag inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <color> lit: Theme.select;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    // Pressed, and then the pointer held at `y` in the window: for a press
    // swept across several.
    callback pressed();
    callback swept(length);
    width: 20px;
    height: 18px;
    border-radius: 3px;
    background: root.on ? (touch.has-hover ? root.lit.brighter(0.12) : root.lit) : touch.pressed ? Theme.control-press : touch.has-hover ? Theme.control-hover : Theme.control;
    animate background { duration: 80ms; }
    Text {
        text: root.label;
        color: root.on ? Theme.on-hue : touch.has-hover ? Theme.text : Theme.text-2;
        font-weight: 600;
        font-size: Theme.t-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.pressed();
            }
        }
        moved => {
            if (self.pressed) {
                root.swept(self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// A slider that only reports what the user does and never changes its own
// value, so the value shown is always the one the kernel holds. Dragging
// sets it, the wheel nudges it, a double click asks for its resting value.
// Neutral: grey on a dark well, blue while it is being dragged.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.text-3;
    in property <bool> centred;   // filled from the middle, as a pan is
    in property <bool> bar;       // a value bar: thicker, with no thumb
    out property <bool> has-hover: touch.has-hover;
    callback moved(float);
    callback reset();
    // Taken hold of (true) and let go (false), for automation that is
    // written while a control is held.
    callback held(bool);
    height: 16px;
    Rectangle {
        x: root.bar ? 0px : 4px;
        width: parent.width - 2 * self.x;
        y: (parent.height - self.height) / 2;
        height: root.bar ? 4px : 3px;
        border-radius: root.bar ? 2px : 1.5px;
        background: Theme.well;
        Rectangle {
            x: root.centred ? min(parent.width / 2, parent.width * clamp(root.value, 0, 1)) : 0;
            width: root.centred ? abs(parent.width * clamp(root.value, 0, 1) - parent.width / 2) : parent.width * clamp(root.value, 0, 1);
            border-radius: 1.5px;
            background: touch.pressed ? Theme.select : touch.has-hover ? Theme.text-2 : root.fill;
        }
    }
    // The thumb.
    if !root.bar: Rectangle {
        x: (parent.width - self.width) * clamp(root.value, 0, 1);
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 14px;
        border-radius: 2px;
        background: touch.pressed ? Theme.text : touch.has-hover ? #dcdee3 : Theme.thumb;
        border-width: 1px;
        border-color: #00000060;
    }
    touch := TouchArea {
        // With Shift held the knob moves a tenth as far as the pointer,
        // from where it was, and does not jump to the pointer.
        property <bool> fine;
        property <float> from;
        property <length> from-x;
        property <float> sent;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.fine = event.modifiers.shift;
                self.from = root.value;
                self.from-x = self.mouse-x;
                self.sent = self.fine ? root.value : clamp((self.mouse-x - 4px) / (self.width - 8px), 0, 1);
                root.held(true);
                root.moved(self.sent);
            }
            if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                root.held(false);
            }
            if (event.kind == PointerEventKind.move && self.pressed) {
                if (event.modifiers.shift != self.fine) {
                    self.fine = event.modifiers.shift;
                    self.from = self.sent;
                    self.from-x = self.mouse-x;
                }
                self.sent = self.fine ? clamp(self.from + (self.mouse-x - self.from-x) / (self.width - 8px) / 10, 0, 1)
                    : clamp((self.mouse-x - 4px) / (self.width - 8px), 0, 1);
                root.moved(self.sent);
            }
        }
        double-clicked => {
            root.reset();
        }
        scroll-event(event) => {
            root.moved(clamp(root.value + (event.delta-y > 0 ? 0.02 : -0.02), 0, 1));
            accept
        }
    }
}

// A small round knob, for a pan. Drag up and down to turn it, the wheel
// nudges it, a double click asks for its resting value. Like the slider it
// shows only the value it is given.
export component Knob inherits Rectangle {
    in property <float> value;    // 0 to 1, the middle at 0.5
    out property <bool> has-hover: touch.has-hover;
    callback moved(float);
    callback reset();
    callback held(bool);
    width: 16px;
    height: 16px;
    property <angle> turn: (clamp(root.value, 0, 1) - 0.5) * 270deg;
    property <length> r: min(self.width, self.height) / 2;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.r * 2;
        height: root.r * 2;
        border-radius: root.r;
        background: touch.pressed ? Theme.control-hover : touch.has-hover ? Theme.control-hover : Theme.control;
        border-width: 1px;
        border-color: Theme.divider;
    }
    // The pointer: a short line from near the middle to the rim.
    for step in 4: Rectangle {
        width: 2px;
        height: 2px;
        border-radius: 1px;
        x: root.width / 2 + (root.r - 2.5px - step * 1.5px) * sin(root.turn) - 1px;
        y: root.height / 2 - (root.r - 2.5px - step * 1.5px) * cos(root.turn) - 1px;
        background: touch.pressed ? Theme.select : Theme.text;
    }
    touch := TouchArea {
        // With Shift held it turns a tenth as fast.
        property <float> start;
        property <length> from-y;
        property <bool> fine;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.start = root.value;
                self.from-y = self.mouse-y;
                self.fine = event.modifiers.shift;
                root.held(true);
            }
            if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                root.held(false);
            }
            if (event.kind == PointerEventKind.move && self.pressed) {
                if (event.modifiers.shift != self.fine) {
                    self.start = clamp(self.start + (self.from-y - self.mouse-y) / (self.fine ? 1200px : 120px), 0, 1);
                    self.from-y = self.mouse-y;
                    self.fine = event.modifiers.shift;
                }
                root.moved(clamp(self.start + (self.from-y - self.mouse-y) / (self.fine ? 1200px : 120px), 0, 1));
            }
        }
        double-clicked => {
            root.reset();
        }
        scroll-event(event) => {
            root.moved(clamp(root.value + (event.delta-y > 0 ? 0.02 : -0.02), 0, 1));
            accept
        }
    }
}

// Where a fader's cap sits for a level in dB, 0 to 1 along its travel:
// 0 dB at 72%, +6 at the top, -60 at the foot, the marks of its scale
// spaced as a mixer's are.
export global Taper {
    pure public function pos(db: float) -> float {
        clamp(db <= -36 ? (db + 60) / 24 * 0.14
            : db <= -24 ? 0.14 + (db + 36) / 12 * 0.11
            : db <= -12 ? 0.25 + (db + 24) / 12 * 0.17
            : db <= -6 ? 0.42 + (db + 12) / 6 * 0.14
            : db <= 0 ? 0.56 + (db + 6) / 6 * 0.16
            : 0.72 + db / 6 * 0.28, 0, 1)
    }
    pure public function db(pos: float) -> float {
        pos <= 0.14 ? pos / 0.14 * 24 - 60
            : pos <= 0.25 ? (pos - 0.14) / 0.11 * 12 - 36
            : pos <= 0.42 ? (pos - 0.25) / 0.17 * 12 - 24
            : pos <= 0.56 ? (pos - 0.42) / 0.14 * 6 - 12
            : pos <= 0.72 ? (pos - 0.56) / 0.16 * 6 - 6
            : (pos - 0.72) / 0.28 * 6
    }
}

// An upright fader with a cap, for a mixer strip. `value` is the volume as
// the kernel's sliders take it, 0 to 1 over -60 to +6 dB; the cap moves
// along the taper above.
export component Fader inherits Rectangle {
    in property <float> value;
    in property <color> cap: Theme.thumb;
    callback moved(float);
    callback reset();
    callback held(bool);
    width: 24px;
    property <float> at: Taper.pos(clamp(root.value, 0, 1) * 66 - 60);
    property <length> travel: self.height - 36px;
    pure function value-at(y: length) -> float {
        (Taper.db(clamp(1 - (y - 18px) / root.travel, 0, 1)) + 60) / 66
    }
    // The slot.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        width: 4px;
        height: parent.height - 32px;
        border-radius: 2px;
        background: Theme.well;
    }
    // The cap: lighter at the top, with a dark line across its middle.
    Rectangle {
        x: 0;
        y: root.travel * (1 - root.at);
        width: parent.width;
        height: 36px;
        border-radius: 3px;
        background: touch.pressed ? @linear-gradient(180deg, #e4e5e8 0%, #c9cbd1 100%) : touch.has-hover ? @linear-gradient(180deg, #d7d9de 0%, #b7b9c0 100%) : @linear-gradient(180deg, #c9cbd1 0%, #a9abb2 100%);
        border-width: 1px;
        border-color: #00000080;
        Rectangle {
            y: (parent.height - 2px) / 2;
            x: 3px;
            width: parent.width - 6px;
            height: 2px;
            background: #1b1c1f;
        }
    }
    touch := TouchArea {
        // With Shift held the cap moves a tenth as far as the pointer, from
        // where it was, and does not jump to the pointer.
        property <bool> fine;
        property <float> from;
        property <length> from-y;
        property <float> sent;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.fine = event.modifiers.shift;
                self.from = root.at;
                self.from-y = self.mouse-y;
                self.sent = self.fine ? root.at : clamp(1 - (self.mouse-y - 18px) / root.travel, 0, 1);
                root.held(true);
                root.moved((Taper.db(self.sent) + 60) / 66);
            }
            if ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel) {
                root.held(false);
            }
            if (event.kind == PointerEventKind.move && self.pressed) {
                if (event.modifiers.shift != self.fine) {
                    self.fine = event.modifiers.shift;
                    self.from = self.sent;
                    self.from-y = self.mouse-y;
                }
                self.sent = self.fine ? clamp(self.from - (self.mouse-y - self.from-y) / root.travel / 10, 0, 1)
                    : clamp(1 - (self.mouse-y - 18px) / root.travel, 0, 1);
                root.moved((Taper.db(self.sent) + 60) / 66);
            }
        }
        double-clicked => {
            root.reset();
        }
        scroll-event(event) => {
            root.moved((Taper.db(clamp(root.at + (event.delta-y > 0 ? 0.015 : -0.015), 0, 1)) + 60) / 66);
            accept
        }
    }
}

// A level meter. Its colour is by position, not by level: green to
// -18 dBFS, then yellow-green, yellow, orange, and red from 0 dB. `hold`
// draws the peak held a moment, as a thin line.
export component Meter inherits Rectangle {
    in property <float> level;
    in property <float> hold;
    in property <bool> upright;
    background: Theme.meter-well;
    clip: true;
    Rectangle {
        x: 0;
        y: root.upright ? parent.height - self.height : 0;
        width: root.upright ? parent.width : parent.width * clamp(root.level, 0, 1);
        height: root.upright ? parent.height * clamp(root.level, 0, 1) : parent.height;
        clip: true;
        Rectangle {
            x: 0;
            y: root.upright ? parent.height - root.height : 0;
            width: root.width;
            height: root.height;
            background: root.upright
                ? @linear-gradient(0deg, Theme.meter-low 0%, Theme.meter-low 63.6%, Theme.meter-mid 63.6%, Theme.meter-mid 77.3%, Theme.meter-high 77.3%, Theme.meter-high 86.4%, Theme.meter-hot 86.4%, Theme.meter-hot 90.9%, Theme.meter-clip 90.9%, Theme.meter-clip 100%)
                : @linear-gradient(90deg, Theme.meter-low 0%, Theme.meter-low 63.6%, Theme.meter-mid 63.6%, Theme.meter-mid 77.3%, Theme.meter-high 77.3%, Theme.meter-high 86.4%, Theme.meter-hot 86.4%, Theme.meter-hot 90.9%, Theme.meter-clip 90.9%, Theme.meter-clip 100%);
        }
    }
    if root.hold > 0.02: Rectangle {
        x: root.upright ? 0 : parent.width * clamp(root.hold, 0, 1) - 1px;
        y: root.upright ? parent.height * (1 - clamp(root.hold, 0, 1)) : 0;
        width: root.upright ? parent.width : 1px;
        height: root.upright ? 1px : parent.height;
        background: root.hold >= 0.909 ? Theme.meter-clip : Theme.text;
    }
}

// The light over a meter that comes on when the level reaches 0 dB and
// stays on until it is clicked.
export component ClipLight inherits Rectangle {
    in property <bool> on;
    callback clear();
    background: root.on ? Theme.meter-clip : Theme.meter-well;
    TouchArea {
        clicked => {
            root.clear();
        }
    }
}
