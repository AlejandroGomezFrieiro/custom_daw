// The colours, the type and the small parts the window is built from:
// buttons, icons, sliders, knobs, faders and meters. Surfaces are neutral
// greys; colour is kept for state (blue selection, amber playhead and loop,
// green play, red record, orange mute, yellow solo) and for what belongs to
// a track (its stripe, clips, notes and name plate).

export global Theme {
    out property <color> bg: #101216;
    out property <color> dark: #0b0c0f;
    out property <color> panel: #26272b;
    out property <color> raised: #1f232b;
    out property <color> high: #2a2f3a;
    out property <color> line: #232730;
    out property <color> line-hi: #343a47;
    out property <color> faint: #4a5060;
    out property <color> dim: #7a8194;
    out property <color> text: #e4e5e8;
    out property <color> bright: #f4f6fa;
    out property <color> accent: #ffb86b;
    out property <color> cyan: #7fd1c7;
    out property <color> blue: #6cb6ff;
    out property <color> green: #9ad36a;
    out property <color> yellow: #f2c94c;
    out property <color> orange: #ff9b5e;
    out property <color> red: #ff6b6b;
    out property <color> magenta: #b79cf2;

    // The palette the window is moving to: surfaces from the back forward,
    // text by weight, and one colour per state. Track hues appear only on
    // what belongs to a track; these never take a track's hue.
    out property <color> surface: #18191c;
    out property <color> lane: #1f2024;
    out property <color> lane-alt: #1c1d20;
    out property <color> panel-sel: #313238;
    out property <color> well: #121315;
    out property <color> divider: #0f1012;
    out property <color> control: #34363c;
    out property <color> control-hover: #3e4047;
    out property <color> control-press: #2a2b30;
    out property <color> line-sub: #25262a;
    out property <color> line-beat: #2c2d32;
    out property <color> line-bar: #3b3d44;
    out property <color> text-2: #a1a3ab;
    out property <color> text-3: #6b6e77;
    out property <color> text-off: #4a4c53;
    out property <color> on-hue: #121316;
    out property <color> select: #46b9fe;
    out property <color> select-fill: #46b9fe26;
    out property <color> play: #fec13a;
    out property <color> play-on: #4ade80;
    out property <color> rec: #ef4444;
    out property <color> mute: #f08a3c;
    out property <color> solo: #f2d24b;
    out property <color> warn: #f2c94c;
    out property <color> error: #ff5a4f;
    out property <color> meter-low: #35c46a;
    out property <color> meter-mid: #a6d84a;
    out property <color> meter-high: #f2d24b;
    out property <color> meter-hot: #f59e3b;
    out property <color> meter-clip: #ff3b30;
    out property <color> meter-well: #0e0f11;
    // Raised parts: device cards and menus, the caps of sliders and faders.
    out property <color> card: #2b2c31;
    out property <color> card-line: #3d3f46;
    out property <color> thumb: #c9cbd1;
    out property <color> thumb-low: #a9abb2;
    out property <color> hover-face: #ffffff12;
    out property <color> press-face: #00000033;

    // Type: Inter for words, JetBrains Mono for numbers that change. Both
    // are built into the program (fonts/), so the window looks the same on
    // any machine.
    out property <string> mono: "JetBrains Mono";
    out property <length> t-micro: 9px;
    out property <length> t-small: 11px;
    out property <length> t-base: 12px;
    out property <length> t-title: 13px;
    out property <length> t-clock: 18px;

    // Where a level in dB sits along a meter, 0 to 1: -60 dB at the foot,
    // +6 at the top, as the Rust side computes `meter`.
    pure public function meter-pos(db: float) -> float {
        clamp((db + 60) / 66, 0, 1)
    }

    // The colour of a mode of the keyboard, as in the terminal's status line.
    pure public function mode-color(mode: string) -> color {
        mode == "x" ? self.magenta : mode == "i" ? self.green : mode == "o" ? self.yellow : mode == "c" ? self.accent : self.blue
    }
}

