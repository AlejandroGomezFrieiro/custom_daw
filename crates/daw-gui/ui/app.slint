                            // out of view, only the part of its picture that shows is drawn.
                            property <length> full: parent.true-w + parent.trim-left - parent.trim-right;
                            property <length> full-x: (parent.trimmed && root.trim-slip ? root.trim-dx : -parent.trim-left) - parent.cut-left;
                            property <length> from: clamp(-self.full-x, 0px, self.full);
                            x: max(self.full-x, min(0px, self.full-x + self.full));
                            y: clip-box.title + 2px;
                            width: clamp(parent.width - self.x, 0px, self.full - self.from);
                            height: parent.height - clip-box.title - 4px;
                            source-clip-x: self.from / max(1px, self.full) * clip.preview.width;
                            source-clip-width: max(1, self.width / max(1px, self.full) * clip.preview.width);
                            source: clip.preview;
                            colorize: clip.muted ? Theme.text-3 : clip.color.mix(white, 0.8);
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        // An audio clip's fades: the part above each line is faded away.
                        property <length> fade-in-x: clamp((root.fade-clip == clip.id && !root.fade-out ? clip.fade-in * root.beat + root.fade-dx : clip.fade-in * root.beat), 0px, self.width);
                        property <length> fade-out-x: clamp((root.fade-clip == clip.id && root.fade-out ? clip.fade-out * root.beat - root.fade-dx : clip.fade-out * root.beat), 0px, self.width);
                        if !clip.midi && self.fade-in-x > 0 && self.cut-left <= 0: Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: "M 0 0 L " + (parent.fade-in-x / 1px) + " 0 L 0 " + (self.height / 1px) + " Z";
                            fill: Theme.surface.with-alpha(0.55);
                            stroke: Theme.text;
                            stroke-width: 1px;
                        }
                        if !clip.midi && self.fade-out-x > 0 && self.cut-right <= 0: Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: "M " + (self.width / 1px) + " 0 L " + ((self.width - parent.fade-out-x) / 1px) + " 0 L " + (self.width / 1px) + " " + (self.height / 1px) + " Z";
                            fill: Theme.surface.with-alpha(0.55);
                            stroke: Theme.text;
                            stroke-width: 1px;
                        }
                        // The gain line, while it is dragged: as high in the waveform as
                        // the clip plays, 0 dB half way up, +6 dB at the top.
                        if root.gain-clip == clip.id: Rectangle {
                            x: 0;
                            y: parent.title + 2px + (1 - clamp(Math.pow(10, root.gain-now / 20) / 2, 0, 1)) * (parent.height - parent.title - 4px);
                            width: parent.width;
                            height: 1px;
                            background: Theme.select;
                        }
                        // Chosen, under the cursor or under the pointer: an outline.
                        if self.current || clip.selected || self.hover: Rectangle {
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: parent.current || clip.selected ? white : #ffffff40;
                        }
                        // The edge that stretches it, while the pointer is on it.
                        if ledge-touch.has-hover: Rectangle {
                            x: 1px;
                            width: 2px;
                            y: 2px;
                            height: parent.height - 4px;
                            border-radius: 1px;
                            background: #ffffffa0;
                        }
                        if edge-touch.has-hover: Rectangle {
                            x: parent.width - 3px;
                            width: 2px;
                            y: 2px;
                            height: parent.height - 4px;
                            border-radius: 1px;
                            background: #ffffffa0;
                        }
                        clip-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: clip.midi ? "Edit notes" : "Select";
                                    activated => {
                                        root.open-clip(clip.id);
                                    }
                                }
                                MenuItem {
                                    title: "Rename";
                                    activated => {
                                        root.clip-command(clip.id, clip.start, "clip.rename");
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Split at the pointer";
                                    activated => {
                                        root.clip-command(clip.id, clip.start + (clip-box.cut-left + clip-touch.menu-x) / root.beat, "clip.split");
                                    }
                                }
                                MenuItem {
                                    title: "Split at the edit cursor   S";
                                    activated => {
                                        root.split-clips(clip.id);
                                    }
                                }
                                MenuItem {
                                    title: "Glue the chosen clips   J";
                                    activated => {
                                        root.glue-clips(clip.id);
                                    }
                                }
                                MenuItem {
                                    title: "Repeat after itself";
                                    activated => {
                                        root.clip-command(clip.id, clip.start, "clip.duplicate");
                                    }
                                }
                                MenuItem {
                                    title: clip.muted ? "Unmute" : "Mute";
                                    activated => {
                                        root.clip-command(clip.id, clip.start, "clip.mute");
                                    }
                                }
                                Menu {
                                    title: clip.takes > 1 ? "Takes (" + clip.take + " of " + clip.takes + ")" : "Takes";
                                    MenuItem {
                                        title: "Next take   ]t";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take next");
                                        }
                                    }
                                    MenuItem {
                                        title: "Take before   [t";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take prev");
                                        }
                                    }
                                    MenuItem {
                                        title: "Choose from a list…";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take.list");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "New take: keep this, carry on in a copy";
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take.new");
                                        }
                                    }
                                    MenuItem {
                                        title: "Throw this take away";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take.remove");
                                        }
                                    }
                                    MenuItem {
                                        title: "Keep only this take";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take.keep");
                                        }
                                    }
                                    MenuItem {
                                        title: "Put the other takes on tracks of their own";
                                        enabled: clip.takes > 1;
                                        activated => {
                                            root.clip-command(clip.id, clip.start, "take.explode");
                                        }
                                    }
                                }
                                for entry[at] in root.clip-entries: MenuItem {
                                    title: entry.label;
                                    enabled: entry.only == "" || (entry.only == "midi") == clip.midi;
                                    activated => {
                                        root.menu-entry("clip", at, clip.id, clip.start + (clip-box.cut-left + clip-touch.menu-x) / root.beat);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Delete";
                                    activated => {
                                        root.clip-command(clip.id, clip.start, "clip.remove");
                                    }
                                }
                            }
                            clip-touch := TouchArea {
                                x: 7px;
                                width: parent.width - 14px;
                                moved => {
                                    if (self.pressed) {
