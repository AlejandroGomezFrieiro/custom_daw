                                            root.drag-dx = self.absolute-position.x + self.mouse-x - root.drag-ax;
                                            root.drag-dy = self.absolute-position.y + self.mouse-y - root.drag-ay;
                                        }
                                    }
                                }
                                property <length> menu-x;
                                // Set by a double click, whose second release is not a click.
                                property <bool> opened;
                                pointer-event(event) => {
