                                        if (root.drag-clip < 0 && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px)) {
                                            root.drag-clip = clip.id;
                                            root.drag-group = clip.selected;
                                            root.drag-ax = self.absolute-position.x + self.pressed-x;
                                            root.drag-ay = self.absolute-position.y + self.pressed-y;
                                            root.drag-row = clip.track;
