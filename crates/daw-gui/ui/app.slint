                                        }
                                        root.gain-clip = -1;
                                    }
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hint = "clip gain: " + round(clip.gain * 10) / 10 + " dB · drag up or down, with Shift finely";
