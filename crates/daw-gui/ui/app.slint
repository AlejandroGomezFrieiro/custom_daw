                                    }
                                    if (event.kind == PointerEventKind.move) {
                                        root.trim-move(clip.id, self.absolute-position.x + self.mouse-x, event.modifiers.shift, event.modifiers.alt);
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        root.trim-release(clip.id, event.modifiers.shift, event.modifiers.alt);
