                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hint = "clip start: drag to trim it, what plays staying where it is · Shift off the grid · Alt slips what plays inside";
                                    } else if (root.hint == "clip start: drag to trim it, what plays staying where it is · Shift off the grid · Alt slips what plays inside") {
                                        root.hint = "";
                                    }
                                }
