                                        root.marquee-press(clip-box.x + self.x + self.mouse-x, clip-box.y + self.mouse-y);
                                    }
                                    if (event.kind == PointerEventKind.move) {
                                        root.marquee-move(clip-box.x + self.x + self.mouse-x, clip-box.y + self.mouse-y);
                                        root.drag-free = event.modifiers.shift;
