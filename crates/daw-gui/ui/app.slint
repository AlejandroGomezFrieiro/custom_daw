                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                        root.pan-press(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                                        root.panning = false;
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right
