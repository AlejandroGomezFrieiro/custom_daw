// The whole graphical frontend: a transport bar, the track list with a
// timeline of clips, the devices of the selected track, and below them the
// mixer and the piano roll.
//
// It holds no project state of its own. Everything shown comes in through
// the properties below, which the Rust side refreshes from the kernel, and
// everything the user does goes out through the callbacks.
//
// What the mouse does:
//   timeline   click puts the cursor, double click makes a clip, drag selects,
//              right drag chooses clips in a box, middle drag pans
//   clip       click chooses (Ctrl toggles, Shift extends), drag moves the
//              chosen (Ctrl copies, Shift off the grid), edges trim (Alt
//              slips), corners fade, top line sets gain, double click opens
//              its notes, right click for the rest
//   ruler      click puts the cursor, drag in the top half loops a stretch,
//              the loop's edges drag
//   header     click selects, double click renames, drag reorders, bottom
//              edge sets the height, M S R sweep, right click for the rest
//   menus      open when the right button is let go, not after a drag
//   piano roll click and drag adds a note of that length, drag moves, right
//              edge resizes, right click removes; drag a velocity bar
//   sliders    drag, wheel to nudge, double click to reset
//   wheel      scrolls; with Ctrl it zooms where the pointer is

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, Button, Flag, Slider, Knob, Fader, Taper, Meter, ClipLight } from "widgets.slint";
// The fonts, built into the program (OFL; their licences are beside them).
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import { Roll, PianoRoll, NoteData, ControlData } from "roll.slint";
import { CanvasWindow, CanvasItem } from "canvas.slint";

export { Roll, CanvasWindow }

export struct TrackData {
    id: int,
    name: string,
    color: color,
    chain: string,      // its devices, and where it goes if not the master
    volume: float,      // fader position, 0..1
    pan: float,         // 0 is left, 0.5 centre, 1 right
    volume-text: string,
    pan-text: string,
    mute: bool,
    solo: bool,
    armed: bool,
    input: string,      // "1", "1/2", or "" for none
    input-label: string, // what it takes in, in words: "UR22mkII · 1/2", or ""
    input-level: float, // what arrives there, 0..1, armed or not
    monitor: bool,      // the input is heard without arming
    master: bool,
    level-l: float,     // meters, 0..1
    level-r: float,
    hold-l: float,      // the peaks held a moment, 0..1
    hold-r: float,
    clipped: bool,      // the level reached 0 dB since the light was cleared
    number: int,        // its place in the list, from 1
    output: string,     // the track it plays into
    inserts: [string],  // the names of its devices
    peak-text: string,  // the peak held, in dB
    lane-name: string,      // the automation lane it shows
    lane-choices: [string], // and the ones it could
    depth: int,         // how many groups it is inside
    group: bool,        // it is a group
    folded: bool,       // and its members are folded away
    members: int,       // how many tracks it holds
    top: float,         // where its row starts and how tall it is, in rows
    size: float,        // of the zoom's height (`row-height`)
    clip-size: float,   // how much of that its clips take: the rest is lanes shown as rows
    automation: string, // "read", "touch", "latch", "write" or "off"
}

export struct ClipData {
    id: int,
    track: int,         // row
    start: float,       // beats
    length: float,
    name: string,
    midi: bool,
    muted: bool,
    color: color,       // its track's
    preview: image,     // its notes or its waveform, to be tinted
    selected: bool,     // chosen with the pointer
    fade-in: float,     // an audio clip's fades, in beats
    fade-out: float,
    gain: float,        // and its gain, in dB
    takes: int,         // how many takes it has (1 without others), and which plays
    take: int,
}

// A send of the selected track: where to, and how much.
export struct SendData {
    name: string,
    value: float,       // slider position, 0..1 over -60 to +6 dB
    text: string,
    pre: bool,          // taken ahead of the fader
}

export struct ParamData {
    key: string,
    name: string,
    value: float,       // 0..1
    text: string,
}

// The automation lane a track shows, drawn over it.
export struct LaneData {
    id: int,
    row: int,
    name: string,       // what it moves: Volume, Pan, Synth · cutoff
    enabled: bool,
    path: string,       // in pixels at the current zoom
    top: float,         // where it is drawn in its track's row, and how tall,
    span: float,        // in rows of the zoom's height
}

// A marker or a region on the ruler: a region has a length.
export struct MarkerData {
    id: int,
    beat: float,
    length: float,
    name: string,
}

// Something the render dialog can render: the song, the loop, a region.
export struct RangeChoice {
    name: string,
    label: string,
}

export struct PointData {
    lane: int,          // lane id
    index: int,         // position among the lane's points
    row: int,
    beat: float,
    value: float,       // 0..1 up its lane
    top: float,         // the lane's place in the row, as `LaneData` has it
    span: float,
}

// One entry of a menu the kernel fills: a track's input, the audio devices.
export struct ChoiceData {
    label: string,
    checked: bool,
}

// One of a device's further output pairs, and the tracks it can play into.
export struct OutputMenuData {
    label: string,
    choices: [ChoiceData],
}

// A key that can follow what has been typed, and what it does.
// An entry an extension added to a right-click menu.
export struct MenuEntry {
    label: string,
    only: string,   // "midi" or "audio" for a clip's entry that is for such clips alone
}

// A bar or beat line from the tempo map: where it is in beats, and the
// bar's number on a bar line ("" on a beat).
export struct RulerLine {
    beat: float,
    label: string,
    // The next line's beat, the bar it is in, and bar.beat for a beat.
    next: float,
    bar: int,
    place: string,
}

// A tempo or time signature change, marked on the ruler.
export struct TempoMark {
    beat: float,
    text: string,
    tempo: bool,
}

export struct HintData {
    key: string,
    desc: string,
}

export struct DeviceData {
    id: int,
    name: string,
    format: string,
    bypass: bool,
    has-editor: bool,
    editor-open: bool,
    stopped: string,    // why a plugin has stopped working, or ""
    status: string,     // "running", "loading", "stopped", "offline" or "missing"
    params: [ParamData],
    more: int,
    preset: string,     // the preset last loaded or saved, or ""
    wet: float,         // the host's wet share, 0 to 1
    gain: float,        // the host's output gain, in dB
    keyed: bool,        // it can listen to a side-chain
    sidechain: string,  // the track it listens to, or ""
    pairs: int,         // its output pairs, 1 for most devices
    routed: int,        // how many of the further ones play somewhere
}

// A track's strip in the mixer, from the top: where its sound goes, its
// devices, its pan, its fader beside its meters, the level in numbers, its
// switches, and its name on its colour.
component MixerStrip inherits Rectangle {
    in property <TrackData> track;
    in property <bool> chosen;
    callback select();
    callback set-volume(float);
    callback reset-volume();
    callback set-pan(float);
    callback hold(string, bool);    // the fader or the pan taken hold of, or let go
    callback toggle-flag(string);
    callback clear-clip();
    callback pick-device(int);
    callback hint(string);
    background: root.chosen ? Theme.panel-sel : Theme.panel;
    TouchArea {
        clicked => {
            root.select();
        }
    }
    Rectangle {
        x: parent.width;
        width: 1px;
        background: Theme.divider;
    }
    VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 4px;
        spacing: 4px;
        // Where it plays into.
        Rectangle {
            height: 20px;
            border-radius: 3px;
            background: Theme.well;
            Text {
                x: 5px;
                width: parent.width - 10px;
                text: root.track.master ? "Output" : "→ " + root.track.output;
                color: Theme.text-2;
                font-size: Theme.t-small;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        // Its devices, four at most (one when the strip is short); a click
        // picks one in the device panel.
        for slot in (root.height < 300px ? 1 : 4): slot-box := Rectangle {
            height: 18px;
            border-radius: 2px;
            property <bool> used: slot < root.track.inserts.length;
            background: self.used ? (slot-touch.has-hover ? Theme.control-hover : Theme.control) : Theme.control-press;
            if slot-box.used: Text {
                x: 5px;
                width: parent.width - 10px;
                text: root.height < 300px && root.track.inserts.length > 1 ? root.track.inserts[0] + " +" + (root.track.inserts.length - 1) : slot == 3 && root.track.inserts.length > 4 ? "+" + (root.track.inserts.length - 3) + " more" : root.track.inserts[slot];
                color: Theme.text;
                font-size: Theme.t-small;
                vertical-alignment: center;
                overflow: elide;
            }
            slot-touch := TouchArea {
                enabled: slot-box.used;
                clicked => {
                    root.pick-device(slot + 1);
                }
            }
        }
        // The pan.
        HorizontalLayout {
            height: 26px;
            alignment: center;
            Knob {
                width: 24px;
                height: 24px;
                y: 1px;
                value: root.track.pan;
                held(on) => {
                    root.hold("pan", on);
                }
                moved(value) => {
                    root.set-pan(value);
                }
                reset => {
                    root.set-pan(0.5);
                }
                changed has-hover => {
                    root.hint(self.has-hover ? "pan " + root.track.pan-text + ": drag up and down · wheel to nudge · double click for the centre" : "");
                }
            }
        }
        // The fader with its scale, and the meters with the clip light.
        Rectangle {
            vertical-stretch: 1;
            min-height: 80px;
            property <length> travel: self.height - 36px;
            for mark[i] in [6, 0, -6, -12, -24, -36, -60]: Text {
                x: 0;
                width: 18px;
                y: 18px + parent.travel * (1 - Taper.pos(mark)) - 6px;
                height: 12px;
                text: mark > 0 ? "+" + mark : mark < 0 ? "−" + (-mark) : "0";
                color: Theme.text-3;
                font-size: Theme.t-micro;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Fader {
                x: 20px;
                height: parent.height;
                value: root.track.volume;
                held(on) => {
                    root.hold("volume", on);
                }
                moved(value) => {
                    root.set-volume(value);
                }
                reset => {
                    root.reset-volume();
                }
            }
            Rectangle {
                x: parent.width - 18px;
                width: 18px;
                border-radius: 2px;
                background: Theme.well;
                ClipLight {
                    x: 2px;
                    y: 2px;
                    width: 14px;
                    height: 4px;
                    on: root.track.clipped;
                    clear => {
                        root.clear-clip();
                    }
                }
                Meter {
                    x: 2px;
                    y: 8px;
                    width: 6px;
                    height: parent.height - 10px;
                    upright: true;
                    level: root.track.level-l;
                    hold: root.track.hold-l;
                }
                Meter {
                    x: 10px;
                    y: 8px;
                    width: 6px;
                    height: parent.height - 10px;
                    upright: true;
                    level: root.track.level-r;
                    hold: root.track.hold-r;
                }
            }
        }
        // The fader's level, and the loudest peak of late.
        HorizontalLayout {
            height: 18px;
            spacing: 2px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 2px;
                background: Theme.well;
                Text {
                    width: parent.width;
                    text: root.track.volume-text;
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: Theme.t-small;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 2px;
                background: root.track.clipped ? Theme.meter-clip.with-alpha(0.25) : Theme.well;
                Text {
                    width: parent.width;
                    text: root.track.peak-text;
                    color: root.track.clipped ? Theme.meter-clip : Theme.text-2;
                    font-family: Theme.mono;
                    font-size: Theme.t-small;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.clear-clip();
                    }
                }
            }
        }
        // Mute, solo, arm.
        HorizontalLayout {
            height: 20px;
            alignment: center;
            spacing: 2px;
            if !root.track.master: Flag {
                label: "M";
                on: root.track.mute;
                lit: Theme.mute;
                clicked => {
                    root.toggle-flag("mute");
                }
            }
            if !root.track.master: Flag {
                label: "S";
                on: root.track.solo;
                lit: Theme.solo;
                clicked => {
                    root.toggle-flag("solo");
                }
            }
            if !root.track.master: Flag {
                label: "R";
                on: root.track.armed;
                lit: Theme.rec;
                clicked => {
                    root.toggle-flag("armed");
                }
            }
        }
        // Its name, on its colour.
        Rectangle {
            height: 22px;
            background: root.track.master ? Theme.control : root.track.color;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;
                if !root.track.master: Text {
                    text: "\{root.track.number}";
                    color: Theme.on-hue.with-alpha(0.6);
                    font-family: Theme.mono;
                    font-size: Theme.t-small;
                    vertical-alignment: center;
                }
                Text {
                    text: root.track.name;
                    color: root.track.master ? Theme.text : Theme.on-hue;
                    font-size: Theme.t-small;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.chosen: Rectangle {
                border-width: 1px;
                border-color: white;
            }
        }
    }
}

export component App inherits Window {
    title: "daw – " + root.project-name + (root.modified ? " •" : "");
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 860px;
    min-height: 480px;
    background: Theme.surface;
    default-font-family: "Inter";
    default-font-size: 12px;

    in property <[TrackData]> tracks;
    in property <[ClipData]> clips;
    in property <[DeviceData]> devices;
    // Device kinds matching what is typed in the search box.
    in property <[string]> device-matches;
    // The clip under the kernel's cursor.
    in property <int> selected-clip: -1;
    in property <[LaneData]> lanes;
    in property <[PointData]> points;
    // Lanes shown as rows of their own under their tracks, always there to
    // draw on: `strip-pencil` is the pencil over one (the lane, a beat, a
    // height in it, then 0 down, 1 move, 2 up).
    in property <[LaneData]> strips;
    in property <[PointData]> strip-points;
    callback strip-pencil(int, float, float, int);
    in property <int> strip-pencil-lane: -1;
    in property <string> strip-pencil-path;
    callback lane-id-command(int, string);  // a lane, and "clear", "toggle" or "hide"
    in property <[MarkerData]> markers;
    // A fader, pan or parameter taken hold of or let go: the track, what
    // ("volume", "pan", "param"), the device and the parameter's key.
    callback hold(int, string, int, string, bool);
    // The File menu: "new", "open" or "quit", asked about first when there
    // are changes to save (`closing` is that question; `close-choice` its
    // answer: "save", "discard" or "cancel").
    callback file-action(string);
    in-out property <bool> closing;
    in property <string> closing-name;
    in property <string> closing-what;
    callback close-choice(string);
    // The render dialog, filled by `open-render` and sent by `start-render`.
    callback open-render();
    callback start-render();
    in-out property <bool> render-open;
    in-out property <string> render-path;
    in property <[RangeChoice]> render-ranges;
    in-out property <int> render-range;
    in-out property <bool> render-flac;
    in-out property <int> render-bits: 24;
    in-out property <string> render-tail: "1";
    in-out property <bool> render-normalize;
    in-out property <bool> render-dither;
    in-out property <bool> render-mono;
    in-out property <bool> render-stems;
    // A render under way in the background.
    in property <bool> rendering;
    in property <float> render-fraction;
    in property <string> render-name;
    // What is waiting for a MIDI controller to be moved, or "".
    in property <string> learning;
    in-out property <bool> show-automation;
    in property <bool> show-mixer;

    // Modal editing: the kernel's key mappings run the keyboard, and report
    // where they are.
    in property <string> mode: "n";
    in property <string> mode-name: "NORMAL";
    in property <string> pending;       // keys of a half-typed command
    in property <string> macro;         // the register being recorded into
    in property <string> focused: "arrange";
    in property <string> status;        // the kernel's last message
    in property <int> status-level;     // 0 plain, 1 warning, 2 error
    in property <bool> prompt-open;
    in property <string> prompt;
    in property <string> prompt-before; // the text on either side of its cursor
    in property <string> prompt-after;
    in property <bool> sel-open;
    in property <string> sel-kind;      // "char", "line" or "block"
    in property <int> sel-row;          // first row from the top, and how many
    in property <int> sel-rows;
    in property <float> sel-start;
    in property <float> sel-end;
    in property <int> cursor-row: -1;
    in property <float> grid: 1;
    in property <[HintData]> hints;
    in property <[MenuEntry]> clip-entries;      // what extensions add to the menus
    in property <[MenuEntry]> track-entries;
    in property <[MenuEntry]> timeline-entries;
    in property <string> hint-title;
    in property <bool> float-open;
    in property <string> float-title;
    in property <string> float-text;
    in property <int> float-lines: 1;   // how many lines it has
    // The pointer on it: "down" or the wheel's "scroll_up" and "scroll_down", a line and a column from 1.
    callback float-pointer(string, int, int);
    in property <int> row-device;       // the device panel's cursor
    in property <int> row-param;
    callback key(string, bool, bool, bool);

    // The track whose name is being typed over, or -1.
    in-out property <int> renaming: -1;
    in property <string> project-name: "untitled";
    in property <bool> modified;
    in property <string> selected-name;
    in property <color> selected-color: Theme.text-2;
    in property <int> selected: -1;
    in property <bool> playing;
    in property <bool> recording;       // a take is being made
    in property <bool> record-armed;    // the next play records
    in property <float> position;
    in property <float> cursor;
    in property <string> time: "1.1.00";
    in property <string> clock: "0:00.0";
    in property <string> tempo: "120";
    in property <string> signature: "4/4";
    in property <string> engine;
    in property <float> cpu;
    in property <string> message;
    in property <bool> message-is-error;
    in property <bool> looping;
    in property <float> loop-start;
    in property <float> loop-end;
    in property <bool> metronome;
    in property <float> bar: 4;
    // Bar and beat lines and tempo changes from the tempo map.
    in property <[RulerLine]> ruler-lines;
    in property <[TempoMark]> tempo-marks;
    // A tempo or signature mark: "move" (to a beat), "edit" or "remove".
    callback tempo-mark(string, bool, float, float);
    in property <float> length: 16;
    in-out property <float> zoom: 28;       // pixels per beat in the timeline
    // What the pointer would do where it is, for the status line.
    in-out property <string> hint;

    // Run a command line, exactly as typed after `:` in the terminal UI.
    callback command(string);
    callback feed(string);                  // keys, as if typed
    callback seek(float);
    callback set-loop(float, float);
    callback set-loop-edge(bool, float);    // the loop's start (or end) dragged to a beat
    callback ruler-click(float);            // the edit cursor, and the playhead, to a beat
    callback select-track(int, float);
    callback select-range(int, float, int, float);
    callback set-volume(int, float);
    callback reset-volume(int);
    callback toggle-flag(int, string);
    callback clear-clip(int);               // a track's clip light, by id
    callback pick-device(int, int);         // a track, and the place of one of its devices
    // A track's input menu: filled by `fill-input-menu` just before it
    // opens, chosen from by heading ("audio", "midi", "channel") and place.
    in property <[ChoiceData]> input-audio;
    in property <[ChoiceData]> input-midi;
    in property <[ChoiceData]> input-channel;
    in property <[ChoiceData]> input-midi-out;
    in property <[ChoiceData]> input-midi-out-channel;
    callback fill-input-menu(int);
    callback choose-input(int, string, int);
    // The audio devices, from the engine indicator: the same way.
    in property <[ChoiceData]> engine-info;
    in property <[ChoiceData]> engine-output;
    in property <[ChoiceData]> engine-input;
    in property <[ChoiceData]> engine-block;
    in property <[ChoiceData]> engine-rate;
    in property <[ChoiceData]> engine-backend;
    callback fill-engine-menu();
    callback choose-engine(string, int);
    callback add-device(string);
    callback search-devices(string);
    callback toggle-favourite(string);
    callback toggle-editor(int);
    callback restart-device(int);
    // A device's presets: a step through them, and a menu filled when it opens.
    callback preset-step(int, int);
    callback fill-preset-menu(int);
    in property <[string]> preset-names;
    callback choose-preset(int, int);
    // A device's side-chain: a menu of the tracks it can listen to, filled when it opens.
    callback fill-sidechain-menu(int);
    in property <[ChoiceData]> sidechain-choices;
    callback choose-sidechain(int, int);
    // A device's further output pairs: a menu of where each plays, filled when it opens.
    callback fill-outputs-menu(int);
    in property <[OutputMenuData]> output-pairs;
    callback route-pair(int, int, int);
    callback device-command(int, string);
    // A device card dragged: onto a track (its id, or -1), or to a height in the list.
    callback drop-device(int, int, float, bool);
    callback card-place(int, float, float);
    callback toggle-offline(int);
    // Where the selected track's sound goes.
    in property <string> route-output: "Master";
    in property <[string]> route-targets;       // tracks it can play into; the master first
    in property <[SendData]> route-sends;
    in property <bool> route-master;            // the selected track is the master
    callback choose-output(int);                // a place in `route-targets`
    callback add-send(int);
    callback set-send(int, float);
    callback toggle-send-pre(int);
    callback remove-send(int);
    callback fold-track(int);
    callback select-clip(int, float, int);     // the clip, the beat, 0 alone, 1 add (Shift), 2 toggle (Ctrl)
    // A box drawn with the right button: rows from 1, beats, and the mode as above.
    callback select-clips-box(int, float, int, float, int);
    callback move-clip(int, float, int, bool, bool);   // the clip grabbed, beats and rows it went, copy (Ctrl), free (Shift)
    callback resize-clip(int, float);
    // An edge of a clip dragged: the clip, the start (or the end), how many
    // beats, free of the grid (Shift), slipping what plays inside (Alt).
    callback trim-edge(int, bool, float, bool, bool);
    // A corner handle of an audio clip: the clip, the fade out (or in), its length in beats.
    callback set-fade(int, bool, float);
    // The top line of an audio clip: the clip and its gain in dB.
    callback set-clip-gain(int, float);
    callback clip-command(int, float, string);
    // The clip menu's "Split at the edit cursor" and "Glue", on the chosen clips or the clip.
    callback split-clips(int);
    callback glue-clips(int);
    callback track-command(int, string);
    callback menu-entry(string, int, int, float);   // which menu, which entry, the clip or track, the beat
    callback move-track(int, int);
    // A track's bottom edge dragged: the track, and its height as a share of `row-height`.
    callback set-track-height(int, float);
    // A press on M, S or R swept across others: rows from 1, the flag, and how it is set.
    callback sweep-flag(int, int, string, bool);
    callback record();
    // The pencil over a track's lane: row, beat, height, then 0 down, 1 move, 2 up.
    callback pencil(int, float, float, int);
    in property <string> pencil-path;
    in property <int> pencil-row: -1;
    callback move-point(int, int, float, float);
    callback remove-point(int, int);
    callback show-lane(int, int);           // a track, and which of its choices
    callback lane-command(int, string);     // a row, and "clear" or "toggle"
    callback automate-param(int, string);
    // Where the take being recorded began.
    in property <float> rec-start;
    public function focus-keys() {
        keys.focus();
    }
    callback set-pan(int, float);
    callback rename-track(int, string);
    callback open-clip(int);
    callback add-clip-at(int, float);
    callback remove-device(int);
    callback move-device(int, int);
    callback toggle-bypass(int);
    callback set-param(int, string, float);
    callback reset-param(int, string);

    property <length> header-width: 240px;
    // How tall a track is drawn: one of a few sizes, stepped through with
    // the buttons, Ctrl and the up and down keys, or Alt and the wheel.
    in-out property <length> row-height: 66px;
    // How tall all the rows are together, in rows of `row-height`: each
    // track's own height is a share of it (`TrackData.size`).
    in property <float> rows-total: 1;
    // The row at a height in rows from the top, from 0.
    pure callback row-at-rows(float) -> int;
    pure function row-top(row: int) -> length {
        row >= root.tracks.length ? root.rows-total * root.row-height : root.tracks[max(0, row)].top * root.row-height
    }
    pure function row-size(row: int) -> length {
        root.tracks[clamp(row, 0, root.tracks.length - 1)].size * root.row-height
    }
    // What shows of the timeline, with room to spare on both sides. Nothing
    // that is drawn reaches further than this, however long the song or far
    // in the zoom: the renderer counts pixels in sixteen bits, and a
    // rectangle wider than that would end the program. `seen-x` and
    // `seen-w` are where something at `x`, `w` wide, starts and how wide it
    // is within what shows.
    // The beats at the left and right edges of what shows, for the program
    // to give the ruler and the grid only the lines that are there.
    out property <float> view-start: -lanes.content-x / root.beat;
    out property <float> view-end: (-lanes.content-x + lanes.width) / root.beat;
    property <length> view-left: -lanes.content-x - 600px;
    property <length> view-right: -lanes.content-x + lanes.width + 600px;
    pure function seen-x(x: length) -> length {
        clamp(x, root.view-left, root.view-right)
    }
    pure function seen-w(x: length, w: length) -> length {
        clamp(x + w, root.view-left, root.view-right) - clamp(x, root.view-left, root.view-right)
    }
    // The part of a row its clips take.
    pure function row-clip(row: int) -> length {
        root.tracks[clamp(row, 0, root.tracks.length - 1)].clip-size * root.row-height
    }
    property <length> rows-height: root.rows-total * root.row-height;
    // The ruler's own rows, and under them a band for markers and regions
    // when there are any.
    property <length> ruler-main: 28px;
    property <length> ruler-height: root.ruler-main + (root.markers.length > 0 ? 18px : 0px);
    property <int> bars: Math.ceil((root.length + 8 * root.bar) / root.bar);
    property <length> beat: root.zoom * 1px;
    in-out property <length> roll-height: 330px;

    // Zoom the timeline by a wheel step, keeping the beat under the pointer
    // (at `x` in the timeline's content) where it is.
    function zoom-timeline(delta: length, x: length) {
        if ((delta > 0 && root.zoom < 320) || (delta < 0 && root.zoom > 3)) {
            lanes.content-x = min(0px, lanes.content-x - x * ((delta > 0 ? 1.2 : 1 / 1.2) - 1));
            root.zoom = clamp(root.zoom * (delta > 0 ? 1.2 : 1 / 1.2), 3, 320);
        }
    }
    // Taller or shorter tracks. The header shows less as there is less room.
    function zoom-rows(taller: bool) {
        if (taller) {
            root.row-height = root.row-height < 44px ? 44px : root.row-height < 66px ? 66px : root.row-height < 96px ? 96px : 140px;
        } else {
            root.row-height = root.row-height > 96px ? 96px : root.row-height > 66px ? 66px : root.row-height > 44px ? 44px : 28px;
        }
    }
    // The whole song across the timeline.
    function zoom-fit() {
        root.zoom = clamp((lanes.width - 24px) / 1px / max(root.bar, root.length + root.bar), 3, 320);
        lanes.content-x = 0px;
    }
    function zoom-step(closer: bool) {
        root.zoom = closer ? min(320, root.zoom * 1.4) : max(3, root.zoom / 1.4);
    }

    // The row of the timeline at `y` in its content, from 0.
    pure function row-at(y: length) -> int {
        clamp(root.row-at-rows(y / root.row-height), 0, root.tracks.length - 1)
    }
    // What Shift and Ctrl held with a click or a box mean: 0 that alone,
    // 1 add to what is chosen, 2 turn it over.
    pure function modes(shift: bool, ctrl: bool) -> int {
        ctrl ? 2 : shift ? 1 : 0
    }
    // The right button over the timeline: held and moved it draws a box
    // that chooses the clips it touches; let go where it was pressed it
    // opens the menu of what is under it. Points are in the timeline's
    // content.
    // A drag of a clip, and of the chosen clips with it if it is one: which
    // one, where the pointer was pressed (in the window) and how far it has
    // gone, and whether Shift keeps it off the grid. The clips are shown
    // where they would land.
    property <int> drag-clip: -1;
    property <bool> drag-group;
    property <length> drag-ax;
    property <length> drag-ay;
    property <length> drag-dx;
    property <length> drag-dy;
    property <bool> drag-free;
    property <length> drag-shown-dx: root.drag-free ? root.drag-dx : round(root.drag-dx / (root.grid * root.beat)) * root.grid * root.beat;
    property <int> drag-row;            // the row it was grabbed in, and where (in the timeline)
    property <length> drag-cy;
    property <int> drag-rows: root.row-at(root.drag-cy + root.drag-dy) - root.drag-row;
    property <length> drag-shown-dy: root.row-top(root.drag-row + root.drag-rows) - root.row-top(root.drag-row);
    // A drag of an edge of a clip, and the same edge of the chosen clips
    // with it: which clip, which edge and where it was, how far the pointer
    // has gone, and with which keys.
    property <int> trim-clip: -1;
    property <bool> trim-start;
    property <bool> trim-group;
    property <float> trim-at;
    property <length> trim-ax;
    property <length> trim-dx;
    property <bool> trim-free;
    property <bool> trim-slip;
    property <length> trim-shown: root.trim-free || root.trim-slip ? root.trim-dx
        : round((root.trim-at * root.beat + root.trim-dx) / (root.grid * root.beat)) * root.grid * root.beat - root.trim-at * root.beat;
    function trim-press(id: int, start: bool, group: bool, at: float, x: length) {
        root.trim-clip = id;
        root.trim-start = start;
        root.trim-group = group;
        root.trim-at = at;
        root.trim-ax = x;
        root.trim-dx = 0px;
    }
    function trim-move(id: int, x: length, shift: bool, alt: bool) {
        if (root.trim-clip == id) {
            root.trim-dx = x - root.trim-ax;
            root.trim-free = shift;
            root.trim-slip = alt;
        }
    }
    function trim-release(id: int, shift: bool, alt: bool) {
        if (root.trim-clip == id && abs(root.trim-dx) > 2px) {
            root.trim-edge(id, root.trim-start, root.trim-dx / root.beat, shift, alt);
        }
        root.trim-clip = -1;
        root.trim-dx = 0px;
        root.trim-slip = false;
    }
    // A drag of a fade handle or of the gain line: which clip, which, and
    // how far the pointer has gone, sideways for a fade, down for the gain.
    property <int> fade-clip: -1;
    property <bool> fade-out;
    property <length> fade-ax;
    property <length> fade-dx;
    property <int> gain-clip: -1;
    property <length> gain-ay;
    property <float> gain-start;
    property <float> gain-now;
    // A press on M, S or R, swept down (or up) across the others: where it
    // began, which flag and how the first was set, the row it is on, and
    // whether it has left the first.
    property <int> sweep-row: -1;
    property <string> sweep-name;
    property <bool> sweep-on;
    property <int> sweep-last;
    property <bool> sweep-moved;
    function sweep-begin(row: int, name: string, on: bool) {
        root.sweep-row = row;
        root.sweep-last = row;
        root.sweep-name = name;
        root.sweep-on = on;
        root.sweep-moved = false;
    }
    // `y` is in the window.
    function sweep-to(y: length) {
        if (root.sweep-row >= 0) {
            // The master's row takes no flags.
            root.sweep-last = min(root.row-at(y - headers.absolute-position.y - lanes.content-y), root.tracks.length - 2);
            if (root.sweep-last != root.sweep-row || root.sweep-moved) {
                root.sweep-moved = true;
                root.sweep-flag(root.sweep-row + 1, root.sweep-last + 1, root.sweep-name, root.sweep-on);
            }
        }
    }
    // A track's bottom edge being dragged, and how far.
    property <int> size-track: -1;
    property <length> size-ay;
    property <length> size-dy;
    // The middle button held over the timeline pans it: where the pointer
    // was pressed (in the window) and where the view was.
    property <bool> panning;
    property <length> pan-ax;
    property <length> pan-ay;
    property <length> pan-cx;
    property <length> pan-cy;
    function pan-press(x: length, y: length) {
        root.panning = true;
        root.pan-ax = x;
        root.pan-ay = y;
        root.pan-cx = lanes.content-x;
        root.pan-cy = lanes.content-y;
    }
    function pan-move(x: length, y: length) {
        if (root.panning) {
            lanes.content-x = clamp(root.pan-cx + x - root.pan-ax, min(0px, lanes.width - lanes.content-width), 0px);
            lanes.content-y = clamp(root.pan-cy + y - root.pan-ay, min(0px, lanes.height - lanes.content-height), 0px);
        }
    }
    property <bool> marquee;
    property <bool> marquee-moved;
    property <length> mq-x0;
    property <length> mq-y0;
    property <length> mq-x1;
    property <length> mq-y1;
    function marquee-press(x: length, y: length) {
        root.marquee = true;
        root.marquee-moved = false;
        root.mq-x0 = x;
        root.mq-y0 = y;
        root.mq-x1 = x;
        root.mq-y1 = y;
    }
    function marquee-move(x: length, y: length) {
        if (root.marquee) {
            root.mq-x1 = x;
            root.mq-y1 = y;
            if (abs(x - root.mq-x0) > 4px || abs(y - root.mq-y0) > 4px) {
                root.marquee-moved = true;
            }
        }
    }
    // Let go of the right button: true if a box was drawn, which is then
    // taken; false for a click, which opens a menu.
    function marquee-release(shift: bool, ctrl: bool) -> bool {
        if (!root.marquee) {
            return false;
        }
        root.marquee = false;
        if (!root.marquee-moved) {
            return false;
        }
        root.marquee-moved = false;
        root.select-clips-box(
            root.row-at(min(root.mq-y0, root.mq-y1)) + 1, min(root.mq-x0, root.mq-x1) / root.beat,
            root.row-at(max(root.mq-y0, root.mq-y1)) + 1, max(root.mq-x0, root.mq-x1) / root.beat,
            root.modes(shift, ctrl));
        true
    }

    forward-focus: keys;

    // Every key goes to the kernel's key mappings, whenever no text box
    // has the keyboard.
    keys := FocusScope {
        key-pressed(event) => {
            // Zoom is the window's own business: Ctrl with + and - for time,
            // with 0 for the whole song, with the up and down keys for the
            // height of the tracks.
            if (event.modifiers.control && !event.modifiers.alt) {
                if (event.text == "=" || event.text == "+") {
                    root.zoom-step(true);
                    return accept;
                }
                if (event.text == "-") {
                    root.zoom-step(false);
                    return accept;
                }
                if (event.text == "0") {
                    root.zoom-fit();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.zoom-rows(false);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.zoom-rows(true);
                    return accept;
                }
            }
            root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
    }

    VerticalLayout {
        // Transport bar.
        Rectangle {
            height: 40px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                // The project, and whether it has changes to save.
                Rectangle {
                    width: min(180px, project-row.preferred-width);
                    project-row := HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.project-name + "  ▾";
                            color: Theme.text;
                            font-size: Theme.t-title;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.modified ? Theme.play : transparent;
                            }
                        }
                    }
                    file-menu := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "New project";
                                activated => {
                                    root.file-action("new");
                                }
                            }
                            MenuItem {
                                title: "Open…";
                                activated => {
                                    root.file-action("open");
                                }
                            }
                            MenuItem {
                                title: "Recover unsaved work…";
                                activated => {
                                    root.command("recover");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Save";
                                activated => {
                                    root.command("write");
                                }
                            }
                            MenuItem {
                                title: "Save as…";
                                activated => {
                                    root.command("saveas");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Import a sound file…";
                                activated => {
                                    root.command("import");
                                }
                            }
                            MenuItem {
                                title: "Render…";
                                activated => {
                                    root.open-render();
                                }
                            }
                            Menu {
                                title: "Sound files";
                                MenuItem {
                                    title: "Find missing files…";
                                    activated => {
                                        root.command("media.relink");
                                    }
                                }
                                MenuItem {
                                    title: "Copy into the project's folder";
                                    activated => {
                                        root.command("media.collect");
                                    }
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Markers and regions…";
                                activated => {
                                    root.command("marker.list");
                                }
                            }
                            MenuItem {
                                title: "MIDI controllers…";
                                activated => {
                                    root.command("learn.list");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Quit";
                                activated => {
                                    root.file-action("quit");
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                file-menu.show({ x: 0, y: self.height + 4px });
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hint = "project: click for the file menu: new, open, save, import, render, quit";
                                } else if (root.hint == "project: click for the file menu: new, open, save, import, render, quit") {
                                    root.hint = "";
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 4px;
                }
                // The transport's buttons, together.
                HorizontalLayout {
                    spacing: 2px;
                    Button {
                        icon: Icons.ph-skip-back-fill;
                        icon-box: 256;
                        quiet: true;
                        clicked => {
                            root.seek(0);
                        }
                    }
                    Button {
                        icon: Icons.ph-stop-fill;
                        icon-box: 256;
                        quiet: true;
                        clicked => {
                            root.command("transport.stop");
                        }
                    }
                    Button {
                        icon: root.playing ? Icons.ph-pause-fill : Icons.ph-play-fill;
                        icon-box: 256;
                        on: root.playing;
                        lit: Theme.play-on;
                        quiet: true;
                        clicked => {
                            root.command("transport.toggle");
                        }
                    }
                    rec := Button {
                        icon: Icons.ph-record-fill;
                        icon-box: 256;
                        on: root.recording || root.record-armed;
                        lit: Theme.rec;
                        idle-ink: Theme.rec.mix(Theme.text-3, 0.6);
                        quiet: true;
                        clicked => {
                            root.record();
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.hint = "record: starts a take on the armed tracks (R on a track), or on the selected one if none is armed · again to stop";
                            } else if (root.hint == "record: starts a take on the armed tracks (R on a track), or on the selected one if none is armed · again to stop") {
                                root.hint = "";
                            }
                        }
                    }
                    Button {
                        icon: Icons.ph-repeat;
                        icon-box: 256;
                        on: root.looping;
                        quiet: true;
                        clicked => {
                            root.command("transport.loop");
                        }
                    }
                    Button {
                        icon: Icons.ph-metronome;
                        icon-box: 256;
                        on: root.metronome;
                        quiet: true;
                        clicked => {
                            root.command("transport.metronome");
                        }
                    }
                }
                // Where the playhead is: bars and beats, then minutes and seconds.
                Rectangle {
                    width: 168px;
                    border-radius: 4px;
                    background: Theme.well;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: root.time;
                            color: root.playing ? Theme.text : Theme.text;
                            font-family: Theme.mono;
                            font-size: Theme.t-clock;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.clock;
                            color: Theme.text-3;
                            font-family: Theme.mono;
                            font-size: Theme.t-small;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }
                }
                // Tempo: the wheel changes it, or a drag up and down; a
                // double click types it.
                Rectangle {
                    width: 64px;
                    border-radius: 4px;
                    background: tempo-touch.has-hover ? Theme.control-press : Theme.well;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 4px;
                        Text {
                            text: root.tempo;
                            color: Theme.text;
                            font-family: Theme.mono;
                            font-size: Theme.t-base;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "BPM";
                            color: Theme.text-3;
                            font-size: Theme.t-micro;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    tempo-touch := TouchArea {
                        property <length> last;
                        mouse-cursor: ns-resize;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.last = self.mouse-y;
                            }
                        }
                        moved => {
                            if (self.pressed && abs(self.mouse-y - self.last) >= 6px) {
                                root.command(self.mouse-y < self.last ? "tempo by=1" : "tempo by=-1");
                                self.last = self.mouse-y;
                            }
                        }
                        double-clicked => {
                            root.feed(":tempo ");
                        }
                        scroll-event(event) => {
                            root.command(event.delta-y > 0 ? "tempo by=1" : "tempo by=-1");
                            accept
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.hint = "tempo: wheel or drag up and down to change it · double click to type it";
                            } else if (root.hint == "tempo: wheel or drag up and down to change it · double click to type it") {
                                root.hint = "";
                            }
                        }
                    }
                }
                // The time signature.
                Rectangle {
                    width: 48px;
                    border-radius: 4px;
                    background: Theme.well;
                    Text {
                        text: root.signature;
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: Theme.t-base;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 8px;
                }
                HorizontalLayout {
                    spacing: 2px;
                    Button {
                        icon: Icons.ph-arrow-counter-clockwise;
                        icon-box: 256;
                        quiet: true;
                        clicked => {
                            root.command("undo");
                        }
                    }
                    Button {
                        icon: Icons.ph-arrow-clockwise;
                        icon-box: 256;
                        quiet: true;
                        clicked => {
                            root.command("redo");
                        }
                    }
                }
                Rectangle {
                    width: 8px;
                }
                // A new track: at once, or from a list when extensions
                // have kinds of track of their own to offer.
                track-menu := ContextMenuArea {
                    horizontal-stretch: 0;
                    Menu {
                        MenuItem {
                            title: "Empty track";
                            activated => {
                                root.command("track.add");
                            }
                        }
                        MenuItem {
                            title: "From a sound file…";
                            activated => {
                                root.command("import");
                            }
                        }
                        for entry[at] in root.timeline-entries: MenuItem {
                            title: entry.label;
                            activated => {
                                root.menu-entry("timeline", at, root.selected, -1);
                            }
                        }
                    }
                    Button {
                        icon: Icons.ph-plus;
                        icon-box: 256;
                        label: "Track";
                        clicked => {
                            track-menu.show({ x: 0, y: self.height + 2px });
                        }
                    }
                }
                // Which views show: one segmented switch.
                Rectangle {
                    border-radius: 4px;
                    background: Theme.well;
                    width: views.preferred-width;
                    views := HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        Button {
                            height: 24px;
                            icon: Icons.ph-faders;
                            icon-box: 256;
                            label: "Mixer";
                            quiet: true;
                            on: root.show-mixer;
                            clicked => {
                                root.command("view.toggle mixer");
                                keys.focus();
                            }
                        }
                        Button {
                            height: 24px;
                            icon: Icons.ph-chart-line;
                            icon-box: 256;
                            label: "Automation";
                            quiet: true;
                            on: root.show-automation;
                            clicked => {
                                root.show-automation = !root.show-automation;
                            }
                        }
                        Button {
                            height: 24px;
                            icon: Icons.ph-piano-keys;
                            icon-box: 256;
                            label: "Piano roll";
                            quiet: true;
                            on: Roll.open;
                            // Opens the notes of the clip at the cursor, or closes the roll.
                            clicked => {
                                root.command(Roll.open ? "view.toggle pianoroll" : "clip.edit");
                                keys.focus();
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hint = "piano roll: opens the notes of the clip at the cursor, or closes them";
                                } else if (root.hint == "piano roll: opens the notes of the clip at the cursor, or closes them") {
                                    root.hint = "";
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                // How hard the engine is working; a click chooses the devices.
                Rectangle {
                    min-width: 48px;
                    preferred-width: 220px;
                    max-width: 220px;
                    border-radius: 4px;
                    background: engine-touch.has-hover ? Theme.hover-face : transparent;
                    engine-menu := ContextMenuArea {
                        Menu {
                            for entry in root.engine-info: MenuItem {
                                title: entry.label;
                                enabled: false;
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Output";
                                enabled: false;
                            }
                            for entry[at] in root.engine-output: MenuItem {
                                title: entry.label;
                                checked: entry.checked;
                                activated => {
                                    root.choose-engine("output", at + 1);
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Input";
                                enabled: false;
                            }
                            for entry[at] in root.engine-input: MenuItem {
                                title: entry.label;
                                checked: entry.checked;
                                activated => {
                                    root.choose-engine("input", at + 1);
                                }
                            }
                            MenuSeparator { }
                            Menu {
                                title: "Block size";
                                for entry[at] in root.engine-block: MenuItem {
                                    title: entry.label;
                                    checked: entry.checked;
                                    activated => {
                                        root.choose-engine("block", at + 1);
                                    }
                                }
                            }
                            Menu {
                                title: "Sample rate";
                                for entry[at] in root.engine-rate: MenuItem {
                                    title: entry.label;
                                    checked: entry.checked;
                                    activated => {
                                        root.choose-engine("rate", at + 1);
                                    }
                                }
                            }
                            Menu {
                                title: "Sound system";
                                for entry[at] in root.engine-backend: MenuItem {
                                    title: entry.label;
                                    checked: entry.checked;
                                    activated => {
                                        root.choose-engine("backend", at + 1);
                                    }
                                }
                            }
                        }
                        engine-touch := TouchArea {
                            clicked => {
                                root.fill-engine-menu();
                                engine-menu.show({ x: 0px, y: self.height });
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hint = "audio: click to choose the output and input devices and the block size";
                                } else if (root.hint == "audio: click to choose the output and input devices and the block size") {
                                    root.hint = "";
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: root.message != "" ? root.message : root.engine;
                            color: root.message != "" && root.message-is-error ? Theme.error : Theme.text-3;
                            font-size: Theme.t-small;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // How much of each block the engine needs.
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.well;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * clamp(root.cpu, 0, 1);
                                    border-radius: 2px;
                                    background: root.cpu > 0.9 ? Theme.error : root.cpu > 0.7 ? Theme.warn : Theme.text-3;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        HorizontalLayout {
            // Tracks: headers on the left, the timeline beside them.
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // Ruler, scrolling sideways with the timeline. A click moves
                // the playhead; a drag loops the stretch dragged over.
                Rectangle {
                    x: root.header-width;
                    y: 0;
                    width: parent.width - root.header-width;
                    height: root.ruler-main;
                    background: Theme.panel;
                    clip: true;
                    // The loop: a band along the top, amber while it is on.
                    if root.loop-end > root.loop-start: Rectangle {
                        x: root.seen-x(root.loop-start * root.beat) + lanes.content-x;
                        width: root.seen-w(root.loop-start * root.beat, (root.loop-end - root.loop-start) * root.beat);
                        background: root.looping ? Theme.play.with-alpha(0.2) : transparent;
                        Rectangle {
                            y: 0;
                            height: 8px;
                            background: root.looping ? Theme.play.with-alpha(0.8) : Theme.text-3.with-alpha(0.45);
                        }
                    }
                    // From the tempo map: half beats and beats of the signature
                    // as ticks from the foot, bars as lines with their numbers.
                    if root.beat >= 20px: Rectangle {
                        for line in root.ruler-lines: Rectangle {
                            x: (line.beat + line.next) / 2 * root.beat + lanes.content-x;
                            width: 1px;
                            y: parent.height - 3px;
                            height: 3px;
                            background: Theme.line-bar;
                        }
                    }
                    if root.beat >= 6px: Rectangle {
                        for line in root.ruler-lines: Rectangle {
                            visible: line.label == "";
                            x: line.beat * root.beat + lanes.content-x;
                            width: 1px;
                            y: parent.height - 6px;
                            height: 6px;
                            background: Theme.text-3;
                        }
                    }
                    if root.beat > 48px: Rectangle {
                        for line in root.ruler-lines: Text {
                            visible: line.label == "";
                            x: line.beat * root.beat + lanes.content-x + 4px;
                            y: 9px;
                            text: line.place;
                            color: Theme.text-3;
                            font-size: Theme.t-small;
                        }
                    }
                    for line in root.ruler-lines: Rectangle {
                        visible: line.label != "";
                        x: line.beat * root.beat + lanes.content-x;
                        width: 1px;
                        y: 8px;
                        height: parent.height - 8px;
                        background: Theme.line-bar;
                    }
                    for line in root.ruler-lines: Text {
                        // Fewer numbers when bars are narrow.
                        visible: line.label != "" && (root.bar * root.beat >= 26px || Math.mod(line.bar - 1, 4) == 0);
                        x: line.beat * root.beat + lanes.content-x + 4px;
                        y: 9px;
                        text: line.label;
                        color: Theme.text-2;
                        font-size: Theme.t-small;
                        font-weight: 600;
                    }
                    // A loop being drawn in the top band, or an edge of it dragged.
                    if ruler-touch.pressed && abs(ruler-touch.mouse-x - ruler-touch.pressed-x) > 4px && (ruler-touch.grab != 0 || ruler-touch.top-band): Rectangle {
                        property <length> from: ruler-touch.grab == 1 ? root.loop-end * root.beat + lanes.content-x
                            : ruler-touch.grab == 2 ? root.loop-start * root.beat + lanes.content-x : ruler-touch.pressed-x;
                        x: min(ruler-touch.mouse-x, self.from);
                        width: abs(ruler-touch.mouse-x - self.from);
                        background: Theme.play.with-alpha(0.3);
                    }
                    // The edit cursor, and the playhead's cap.
                    Rectangle {
                        x: root.cursor * root.beat + lanes.content-x;
                        y: 8px;
                        width: 1px;
                        height: parent.height - 8px;
                        background: Theme.select;
                    }
                    Path {
                        x: root.position * root.beat + lanes.content-x - 4.5px;
                        y: parent.height - 6px;
                        width: 9px;
                        height: 6px;
                        viewbox-width: 9;
                        viewbox-height: 6;
                        commands: "M 0 0 H 9 L 4.5 6 Z";
                        fill: Theme.play;
                    }
                    ruler-touch := TouchArea {
                        // Under the tempo flags, which come after it.
                        // What a press took hold of: 1 the loop's start, 2 its end, 0 neither;
                        // and whether it was in the top band, where a drag draws a loop.
                        property <int> grab;
                        property <bool> top-band;
                        pure function near(beat: float) -> bool {
                            root.looping && abs(self.mouse-x - (beat * root.beat + lanes.content-x)) <= 5px
                        }
                        mouse-cursor: self.near(root.loop-start) || self.near(root.loop-end) ? MouseCursor.ew-resize : MouseCursor.default;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                keys.focus();
                                self.grab = self.near(root.loop-start) ? 1 : self.near(root.loop-end) ? 2 : 0;
                                self.top-band = self.mouse-y < self.height / 2;
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                if (abs(self.mouse-x - self.pressed-x) <= 4px) {
                                    root.ruler-click((self.mouse-x - lanes.content-x) / root.beat);
                                } else if (self.grab != 0) {
                                    root.set-loop-edge(self.grab == 1, (self.mouse-x - lanes.content-x) / root.beat);
                                } else if (self.top-band) {
                                    root.set-loop((self.pressed-x - lanes.content-x) / root.beat, (self.mouse-x - lanes.content-x) / root.beat);
                                } else {
                                    root.ruler-click((self.mouse-x - lanes.content-x) / root.beat);
                                }
                                self.grab = 0;
                            }
                        }
                        double-clicked => {
                            root.command("transport.loop");
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.hint = "ruler: click puts the edit cursor and the playhead · drag in the top half loops a stretch · drag the loop's edges · double click turns the loop on or off";
                            } else if (root.hint == "ruler: click puts the edit cursor and the playhead · drag in the top half loops a stretch · drag the loop's edges · double click turns the loop on or off") {
                                root.hint = "";
                            }
                        }
                    }
                    // Tempo and signature changes: a flag each, dragged to move,
                    // double clicked to type a value, removed from its menu.
                    // A stem at the change's beat, and the flag beside the bar number.
                    for mark in root.tempo-marks: flag := Rectangle {
                        property <length> dx: 0px;
                        x: mark.beat * root.beat + lanes.content-x + self.dx;
                        y: 0;
                        width: flag-text.preferred-width + 24px;
                        height: root.ruler-main;
                        // A stem at the change's beat with a small head, and
                        // the value beside the bar number.
                        Rectangle {
                            x: 0;
                            y: 8px;
                            width: 1px;
                            height: parent.height - 8px;
                            background: mark.tempo ? Theme.accent : Theme.text-2;
                        }
                        Rectangle {
                            x: 0;
                            y: 8px;
                            width: 5px;
                            height: 5px;
                            background: mark.tempo ? Theme.accent : Theme.text-2;
                        }
                        flag-text := Text {
                            x: 20px;
                            y: 9px;
                            text: mark.text;
                            font-family: Theme.mono;
                            font-size: Theme.t-small;
                            font-weight: 600;
                            color: mark.tempo ? Theme.accent : Theme.text-2;
                        }
                        flag-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: mark.tempo ? "Change tempo…" : "Change signature…";
                                    activated => {
                                        root.tempo-mark("edit", mark.tempo, mark.beat, 0);
                                    }
                                }
                                MenuItem {
                                    title: mark.tempo ? "Remove tempo change" : "Remove signature change";
                                    activated => {
                                        root.tempo-mark("remove", mark.tempo, mark.beat, 0);
                                    }
                                }
                            }
                        }
                        TouchArea {
                            moved => {
                                // The flag moves under the pointer, so each move adds on.
                                if (self.pressed) {
                                    parent.dx += self.mouse-x - self.pressed-x;
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    flag-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    if (abs(parent.dx) > 3px) {
                                        root.tempo-mark("move", mark.tempo, mark.beat, mark.beat + parent.dx / root.beat);
                                    }
                                    parent.dx = 0px;
                                }
                            }
                            double-clicked => {
                                root.tempo-mark("edit", mark.tempo, mark.beat, 0);
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hint = "tempo flag: drag to move · double click to type a value · right click to remove";
                                } else if (root.hint == "tempo flag: drag to move · double click to type a value · right click to remove") {
                                    root.hint = "";
                                }
                            }
                        }
                    }
                }

                // Markers and regions, in a band of their own under the
                // ruler: a region is a bar over its stretch, a marker a flag.
                // A click goes there; a drag moves one; the menu renames,
                // removes, and loops a region.
                if root.markers.length > 0: Rectangle {
                    x: root.header-width;
                    y: root.ruler-main;
                    width: parent.width - root.header-width;
                    height: root.ruler-height - root.ruler-main;
                    background: Theme.panel;
                    clip: true;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.divider;
                    }
                    for marker in root.markers: marker-box := Rectangle {
                        property <length> dx: 0px;
                        property <bool> region: marker.length > 0;
                        // A region that starts out of view is drawn from the edge of what shows.
                        property <length> shown: root.seen-w(marker.beat * root.beat, marker.length * root.beat);
                        x: (self.region ? root.seen-x(marker.beat * root.beat) : marker.beat * root.beat) + lanes.content-x + self.dx;
                        y: 1px;
                        width: self.region ? max(marker-text.preferred-width + 12px, self.shown) : marker-text.preferred-width + 14px;
                        height: parent.height - 2px;
                        if marker-box.region: Rectangle {
                            width: marker-box.shown;
                            border-radius: 2px;
                            background: Theme.select.with-alpha(marker-touch.has-hover ? 0.38 : 0.24);
                        }
                        Rectangle {
                            x: 0;
                            width: marker-box.region ? 2px : 1px;
                            background: marker-box.region ? Theme.select : Theme.accent;
                        }
                        marker-text := Text {
                            x: 6px;
                            text: marker.name;
                            color: marker-box.region ? Theme.text : Theme.accent;
                            font-size: Theme.t-small;
                            font-weight: 600;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        marker-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Rename…";
                                    activated => {
                                        root.command("marker.rename id=" + marker.id);
                                    }
                                }
                                MenuItem {
                                    title: "Loop this region";
                                    enabled: marker-box.region;
                                    activated => {
                                        root.command("region.loop id=" + marker.id);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Remove";
                                    activated => {
                                        root.command("marker.remove id=" + marker.id);
                                    }
                                }
                            }
                            marker-touch := TouchArea {
                                moved => {
                                    // It moves under the pointer, so each move adds on.
                                    if (self.pressed) {
                                        marker-box.dx += self.mouse-x - self.pressed-x;
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                        marker-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        keys.focus();
                                        if (abs(marker-box.dx) > 3px) {
                                            root.command("marker.set id=" + marker.id + " beat=" + max(0, marker.beat + marker-box.dx / root.beat));
                                        } else {
                                            root.command("marker.goto id=" + marker.id);
                                        }
                                        marker-box.dx = 0px;
                                    }
                                }
                                double-clicked => {
                                    root.command("marker.rename id=" + marker.id);
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hint = "marker: click goes there · drag to move · double click renames · right click for more";
                                    } else if (root.hint == "marker: click goes there · drag to move · double click renames · right click for more") {
                                        root.hint = "";
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: 0;
                    width: root.header-width;
                    height: root.ruler-height;
                    background: Theme.panel;
                    Text {
                        x: 12px;
                        text: root.tracks.length - 1 == 1 ? "1 TRACK" : (root.tracks.length - 1) + " TRACKS";
                        color: Theme.text-3;
                        font-size: Theme.t-micro;
                        font-weight: 600;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }

                // Track headers, scrolling up and down with the timeline.
                headers := Rectangle {
                    x: 0;
                    y: root.ruler-height;
                    width: root.header-width;
                    height: parent.height - root.ruler-height;
                    clip: true;
                    for track[index] in root.tracks: header-row := Rectangle {
                        // How far the header has been dragged, to move the track.
                        property <length> dy: 0px;
                        y: track.top * root.row-height + lanes.content-y + self.dy;
                        height: max(18px, track.size * root.row-height - 1px + (root.size-track == track.id ? root.size-dy : 0px));
                        z: root.size-track == track.id ? 1 : 0;
                        background: track.id == root.selected ? Theme.panel-sel : Theme.panel;
                        // A stripe in the track's colour, and a line under it.
                        Rectangle {
                            x: 0;
                            width: 4px;
                            background: track.color;
                        }
                        Rectangle {
                            y: parent.height;
                            height: 1px;
                            background: Theme.divider;
                        }
                        header-menu := ContextMenuArea {
                            enabled: !track.master;
                            Menu {
                                MenuItem {
                                    title: "Rename";
                                    activated => {
                                        root.renaming = track.id;
                                    }
                                }
                                Menu {
                                    title: "Colour";
                                    MenuItem {
                                        title: "Coral";
                                        activated => {
                                            root.track-command(track.id, "track.color coral");
                                        }
                                    }
                                    MenuItem {
                                        title: "Gold";
                                        activated => {
                                            root.track-command(track.id, "track.color gold");
                                        }
                                    }
                                    MenuItem {
                                        title: "Lime";
                                        activated => {
                                            root.track-command(track.id, "track.color lime");
                                        }
                                    }
                                    MenuItem {
                                        title: "Teal";
                                        activated => {
                                            root.track-command(track.id, "track.color teal");
                                        }
                                    }
                                    MenuItem {
                                        title: "Sky";
                                        activated => {
                                            root.track-command(track.id, "track.color sky");
                                        }
                                    }
                                    MenuItem {
                                        title: "Violet";
                                        activated => {
                                            root.track-command(track.id, "track.color violet");
                                        }
                                    }
                                    MenuItem {
                                        title: "Pink";
                                        activated => {
                                            root.track-command(track.id, "track.color pink");
                                        }
                                    }
                                    MenuItem {
                                        title: "Sand";
                                        activated => {
                                            root.track-command(track.id, "track.color sand");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "The theme's";
                                        activated => {
                                            root.track-command(track.id, "track.color none");
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Duplicate";
                                    activated => {
                                        root.track-command(track.id, "track.duplicate");
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "New group with this track…";
                                    activated => {
                                        root.track-command(track.id, "track.group");
                                    }
                                }
                                MenuItem {
                                    title: "Move into a group…";
                                    activated => {
                                        root.track-command(track.id, "track.into");
                                    }
                                }
                                MenuItem {
                                    title: track.group ? "Dissolve the group" : "Take out of its group";
                                    enabled: track.group || track.depth > 0;
                                    activated => {
                                        root.track-command(track.id, "track.ungroup");
                                    }
                                }
                                MenuItem {
                                    title: track.folded ? "Open the group" : "Fold the group away";
                                    enabled: track.group || track.depth > 0;
                                    activated => {
                                        root.track-command(track.id, "track.fold");
                                    }
                                }
                                MenuSeparator { }
                                Menu {
                                    title: "Automation";
                                    MenuItem {
                                        title: "Read: the lanes play";
                                        checked: track.automation == "read";
                                        activated => {
                                            root.track-command(track.id, "automation read");
                                        }
                                    }
                                    MenuItem {
                                        title: "Touch: write while a control is held";
                                        checked: track.automation == "touch";
                                        activated => {
                                            root.track-command(track.id, "automation touch");
                                        }
                                    }
                                    MenuItem {
                                        title: "Latch: write from the first move until stop";
                                        checked: track.automation == "latch";
                                        activated => {
                                            root.track-command(track.id, "automation latch");
                                        }
                                    }
                                    MenuItem {
                                        title: "Write: write everything while playing";
                                        checked: track.automation == "write";
                                        activated => {
                                            root.track-command(track.id, "automation write");
                                        }
                                    }
                                    MenuItem {
                                        title: "Off: the lanes do not play";
                                        checked: track.automation == "off";
                                        activated => {
                                            root.track-command(track.id, "automation off");
                                        }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: "Show or hide the lanes as rows";
                                        activated => {
                                            root.track-command(track.id, "lane.rows");
                                        }
                                    }
                                }
                                Menu {
                                    title: "MIDI controller";
                                    MenuItem {
                                        title: "Learn for the fader…";
                                        activated => {
                                            root.track-command(track.id, "learn volume");
                                        }
                                    }
                                    MenuItem {
                                        title: "Learn for the pan…";
                                        activated => {
                                            root.track-command(track.id, "learn pan");
                                        }
                                    }
                                    MenuItem {
                                        title: "What is bound…";
                                        activated => {
                                            root.command("learn.list");
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Bounce to audio";
                                    activated => {
                                        root.track-command(track.id, "track.bounce");
                                    }
                                }
                                MenuItem {
                                    title: "New track below";
                                    activated => {
                                        root.track-command(track.id, "track.add");
                                    }
                                }
                                for entry[at] in root.track-entries: MenuItem {
                                    title: entry.label;
                                    activated => {
                                        root.menu-entry("track", at, track.id, 0);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Delete";
                                    activated => {
                                        root.track-command(track.id, "track.remove");
                                    }
                                }
                            }
                            header-touch := TouchArea {
                                property <length> right-x;
                                property <length> right-y;
                                moved => {
                                    if (self.pressed && !track.master && abs(self.mouse-y - self.pressed-y) > 6px) {
                                        header-row.dy += self.mouse-y - self.pressed-y;
                                    }
                                }
                                pointer-event(event) => {
                                    // The menu opens when the button is let go, where it was pressed.
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        self.right-x = self.mouse-x;
                                        self.right-y = self.mouse-y;
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right && !track.master
                                        && abs(self.mouse-x - self.right-x) < 5px && abs(self.mouse-y - self.right-y) < 5px) {
                                        header-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        keys.focus();
                                        if (root.row-at(root.row-top(index) + root.row-size(index) / 2 + header-row.dy) != index) {
                                            root.move-track(track.id, root.row-at(root.row-top(index) + root.row-size(index) / 2 + header-row.dy) + 1);
                                        } else {
                                            root.select-track(track.id, root.cursor);
                                        }
                                        header-row.dy = 0px;
                                    }
                                }
                                double-clicked => {
                                    if (!track.master) {
                                        root.renaming = track.id;
                                    }
                                }
                                // Ctrl and the wheel: every track taller or shorter.
                                scroll-event(event) => {
                                    if (event.modifiers.control) {
                                        root.zoom-rows(event.delta-y > 0);
                                        return accept;
                                    }
                                    reject
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                root.hint = "track: click selects · double click renames · drag up or down to move it, into or out of a group · right click for colour and more";
                            } else if (root.hint == "track: click selects · double click renames · drag up or down to move it, into or out of a group · right click for colour and more") {
                                root.hint = "";
                            }
                                }
                            }
                        }
                        // Its number.
                        Text {
                            x: 8px;
                            y: root.row-height < 40px ? 4px : root.row-height < 60px ? 3px : 6px;
                            width: 22px;
                            height: 20px;
                            text: track.master ? "M" : "\{track.number}";
                            color: track.id == root.selected ? Theme.text-2 : Theme.text-3;
                            font-family: Theme.mono;
                            font-size: Theme.t-small;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            // A member of a group stands a step in under it.
                            padding-left: 34px + track.depth * 12px;
                            padding-right: 30px;
                            padding-top: track.clip-size * root.row-height < 40px ? 4px : track.clip-size * root.row-height < 60px ? 3px : 6px;
                            padding-bottom: 2px;
                            spacing: track.clip-size * root.row-height < 60px ? 2px : 4px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 2px;
                                height: 20px;
                                // A group's triangle folds its members away.
                                if track.group: Rectangle {
                                    width: 16px;
                                    Icon {
                                        x: 2px;
                                        y: (parent.height - 12px) / 2;
                                        width: 12px;
                                        height: 12px;
                                        box: 256;
                                        shape: track.folded ? Icons.ph-caret-right : Icons.ph-caret-down;
                                        ink: fold-touch.has-hover ? Theme.text : Theme.text-2;
                                    }
                                    fold-touch := TouchArea {
                                        clicked => {
                                            root.fold-track(track.id);
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.hint = "group: fold its tracks away, or open it";
                                            } else if (root.hint == "group: fold its tracks away, or open it") {
                                                root.hint = "";
                                            }
                                        }
                                    }
                                }
                                if root.renaming != track.id: Text {
                                    text: track.name + (track.folded ? "   +" + track.members : "");
                                    color: Theme.text;
                                    font-weight: track.id == root.selected || track.group ? 600 : 400;
                                    font-size: Theme.t-base;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.renaming == track.id: TextInput {
                                    text: track.name;
                                    color: Theme.text;
                                    selection-background-color: Theme.select.with-alpha(0.4);
                                    font-size: Theme.t-base;
                                    single-line: true;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    accepted => {
                                        root.rename-track(track.id, self.text);
                                        root.renaming = -1;
                                        keys.focus();
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Escape) {
                                            root.renaming = -1;
                                            keys.focus();
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                                // The input: what the track takes in, chosen from a
                                // menu, with the level arriving there along its foot.
                                if !track.master: in-button := Rectangle {
                                    width: 20px;
                                    height: 18px;
                                    y: 1px;
                                    border-radius: 3px;
                                    clip: true;
                                    background: track.input != "" && (track.monitor || track.armed) ? Theme.select.with-alpha(0.25) : in-touch.has-hover ? Theme.control-hover : Theme.control;
                                    Icon {
                                        x: 3px;
                                        y: 2px;
                                        width: 14px;
                                        height: 14px;
                                        box: 256;
                                        shape: Icons.ph-microphone;
                                        ink: track.input != "" ? Theme.select : in-touch.has-hover ? Theme.text : Theme.text-3;
                                    }
                                    if track.input != "": Rectangle {
                                        x: 0;
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: parent.width * min(1, track.input-level);
                                        background: track.input-level > 0.89 ? Theme.meter-clip : Theme.meter-low;
                                    }
                                    in-menu := ContextMenuArea {
                                        Menu {
                                            MenuItem {
                                                title: "Audio";
                                                enabled: false;
                                            }
                                            for entry[at] in root.input-audio: MenuItem {
                                                title: entry.label;
                                                checked: entry.checked;
                                                activated => {
                                                    root.choose-input(track.id, "audio", at + 1);
                                                }
                                            }
                                            MenuSeparator { }
                                            MenuItem {
                                                title: "MIDI";
                                                enabled: false;
                                            }
                                            for entry[at] in root.input-midi: MenuItem {
                                                title: entry.label;
                                                checked: entry.checked;
                                                activated => {
                                                    root.choose-input(track.id, "midi", at + 1);
                                                }
                                            }
                                            Menu {
                                                title: "MIDI channel";
                                                for entry[at] in root.input-channel: MenuItem {
                                                    title: entry.label;
                                                    checked: entry.checked;
                                                    activated => {
                                                        root.choose-input(track.id, "channel", at + 1);
                                                    }
                                                }
                                            }
                                            MenuSeparator { }
                                            MenuItem {
                                                title: "Monitor: hear the input without arming";
                                                checked: track.monitor;
                                                activated => {
                                                    root.toggle-flag(track.id, "monitor");
                                                }
                                            }
                                            MenuSeparator { }
                                            Menu {
                                                title: "MIDI out: send what it plays to";
                                                for entry[at] in root.input-midi-out: MenuItem {
                                                    title: entry.label;
                                                    checked: entry.checked;
                                                    activated => {
                                                        root.choose-input(track.id, "midi_out", at + 1);
                                                    }
                                                }
                                            }
                                            Menu {
                                                title: "MIDI out channel";
                                                for entry[at] in root.input-midi-out-channel: MenuItem {
                                                    title: entry.label;
                                                    checked: entry.checked;
                                                    activated => {
                                                        root.choose-input(track.id, "midi_out_channel", at + 1);
                                                    }
                                                }
                                            }
                                        }
                                        in-touch := TouchArea {
                                            clicked => {
                                                root.fill-input-menu(track.id);
                                                in-menu.show({ x: 0px, y: self.height });
                                            }
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.hint = "input: click to choose what the track records, audio or MIDI · the bar along its foot is the level arriving";
                                                } else if (root.hint == "input: click to choose what the track records, audio or MIDI · the bar along its foot is the level arriving") {
                                                    root.hint = "";
                                                }
                                            }
                                        }
                                    }
                                }
                                // Monitoring: a loudspeaker, lit while the input is heard.
                                if !track.master: Rectangle {
                                    width: 20px;
                                    height: 18px;
                                    y: 1px;
                                    border-radius: 3px;
                                    background: track.monitor ? Theme.select : mon-touch.has-hover ? Theme.control-hover : Theme.control;
                                    Icon {
                                        x: 3px;
                                        y: 2px;
                                        width: 14px;
                                        height: 14px;
                                        box: 256;
                                        shape: Icons.ph-speaker-high;
                                        ink: track.monitor ? Theme.on-hue : mon-touch.has-hover ? Theme.text : Theme.text-3;
                                    }
                                    mon-touch := TouchArea {
                                        clicked => {
                                            root.toggle-flag(track.id, "monitor");
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.hint = "monitor: hear the input through the track's devices without arming it";
                                            } else if (root.hint == "monitor: hear the input through the track's devices without arming it") {
                                                root.hint = "";
                                            }
                                        }
                                    }
                                }
                                if !track.master: Flag {
                                    label: "M";
                                    y: 1px;
                                    on: track.mute;
                                    lit: Theme.mute;
                                    clicked => {
                                        if (!root.sweep-moved) {
                                            root.toggle-flag(track.id, "mute");
                                        }
                                    }
                                    pressed => {
                                        root.sweep-begin(index, "mute", !track.mute);
                                    }
                                    swept(y) => {
                                        root.sweep-to(y);
                                    }
                                }
                                if !track.master: Flag {
                                    label: "S";
                                    y: 1px;
                                    on: track.solo;
                                    lit: Theme.solo;
                                    clicked => {
                                        if (!root.sweep-moved) {
                                            root.toggle-flag(track.id, "solo");
                                        }
                                    }
                                    pressed => {
                                        root.sweep-begin(index, "solo", !track.solo);
                                    }
                                    swept(y) => {
                                        root.sweep-to(y);
                                    }
                                }
                                if !track.master: Flag {
                                    label: "R";
                                    y: 1px;
                                    on: track.armed;
                                    lit: Theme.rec;
                                    clicked => {
                                        if (!root.sweep-moved) {
                                            root.toggle-flag(track.id, "armed");
                                        }
                                    }
                                    pressed => {
                                        root.sweep-begin(index, "armed", !track.armed);
                                    }
                                    swept(y) => {
                                        root.sweep-to(y);
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.hint = "arm: this track records when the record button is pressed";
                                        } else if (root.hint == "arm: this track records when the record button is pressed") {
                                            root.hint = "";
                                        }
                                    }
                                }
                                // The automation mode: A while the lanes only
                                // play, lit with its letter while moves are written.
                                if !track.master: Flag {
                                    label: track.automation == "touch" ? "T" : track.automation == "latch" ? "L" : track.automation == "write" ? "W" : track.automation == "off" ? "–" : "A";
                                    y: 1px;
                                    on: track.automation != "read";
                                    lit: track.automation == "off" ? Theme.text-3 : Theme.rec;
                                    clicked => {
                                        root.track-command(track.id, "automation");
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.hint = "automation: " + track.automation + " · click for the next mode (read, touch, latch, write, off) · the track's menu has them all";
                                        } else {
                                            root.hint = "";
                                        }
                                    }
                                }
                            }
                            if track.clip-size * root.row-height >= 44px: HorizontalLayout {
                                spacing: 6px;
                                height: 16px;
                                Slider {
                                    value: track.volume;
                                    horizontal-stretch: 1;
                                    held(on) => {
                                        root.hold(track.id, "volume", 0, "", on);
                                    }
                                    moved(value) => {
                                        root.set-volume(track.id, value);
                                    }
                                    reset => {
                                        root.reset-volume(track.id);
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                root.hint = "volume: drag · wheel to nudge · double click for 0 dB";
                            } else if (root.hint == "volume: drag · wheel to nudge · double click for 0 dB") {
                                root.hint = "";
                            }
                                    }
                                }
                                Text {
                                    text: track.volume-text;
                                    color: Theme.text-2;
                                    font-family: Theme.mono;
                                    font-size: Theme.t-small;
                                    font-weight: 500;
                                    width: 40px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                // The pan.
                                Knob {
                                    value: track.pan;
                                    held(on) => {
                                        root.hold(track.id, "pan", 0, "", on);
                                    }
                                    moved(value) => {
                                        root.set-pan(track.id, value);
                                    }
                                    reset => {
                                        root.set-pan(track.id, 0.5);
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.hint = "pan " + track.pan-text + ": drag up and down · wheel to nudge · double click for the centre";
                                        } else if (root.hint == "pan " + track.pan-text + ": drag up and down · wheel to nudge · double click for the centre") {
                                            root.hint = "";
                                        }
                                    }
                                }
                            }
                            // What the track's sound goes through; or, while
                            // automation is edited, which lane the track shows.
                            if !root.show-automation && track.clip-size * root.row-height >= 60px: Text {
                                text: (track.input-label == "" ? "" : track.input-label + "  ›  ") + (track.chain == "" ? (track.master ? "" : "no devices") : track.chain);
                                color: Theme.text-3;
                                font-size: Theme.t-small;
                                overflow: elide;
                            }
                            if !root.show-automation && track.clip-size * root.row-height >= 96px: Text {
                                text: track.pan-text == "C" ? "Pan centre" : "Pan " + track.pan-text;
                                color: Theme.text-3;
                                font-size: Theme.t-small;
                                overflow: elide;
                            }
                            if root.show-automation && track.clip-size * root.row-height >= 60px: Rectangle {
                                height: 14px;
                                Text {
                                    text: track.lane-name + "  ▾";
                                    color: lane-pick.has-hover ? Theme.text : Theme.text-2;
                                    font-size: Theme.t-small;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                choices := ContextMenuArea {
                                    Menu {
                                        for name[at] in track.lane-choices: MenuItem {
                                            title: name;
                                            activated => {
                                                root.show-lane(track.id, at);
                                            }
                                        }
                                    }
                                    lane-pick := TouchArea {
                                        clicked => {
                                            choices.show({ x: self.mouse-x, y: self.mouse-y });
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.hint = "automation: click to choose what this track's lane moves; a parameter is added from its device on the right";
                                            } else if (root.hint == "automation: click to choose what this track's lane moves; a parameter is added from its device on the right") {
                                                root.hint = "";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Its meters, left and right, with the clip light on top.
                        Rectangle {
                            x: parent.width - 24px;
                            y: 4px;
                            width: 20px;
                            height: parent.height - 8px;
                            border-radius: 2px;
                            background: Theme.well;
                            ClipLight {
                                x: 3px;
                                y: 2px;
                                width: 14px;
                                height: 4px;
                                on: track.clipped;
                                clear => {
                                    root.clear-clip(track.id);
                                }
                            }
                            Meter {
                                x: 3px;
                                y: 8px;
                                width: 6px;
                                height: parent.height - 10px;
                                upright: true;
                                level: track.level-l;
                                hold: track.hold-l;
                            }
                            Meter {
                                x: 11px;
                                y: 8px;
                                width: 6px;
                                height: parent.height - 10px;
                                upright: true;
                                level: track.level-r;
                                hold: track.hold-r;
                            }
                        }
                        // The bottom edge: drag to make the track taller or shorter,
                        // double click for the height of the others.
                        TouchArea {
                            y: parent.height - 4px;
                            height: 5px;
                            mouse-cursor: ns-resize;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.size-track = track.id;
                                    root.size-ay = self.absolute-position.y + self.mouse-y;
                                    root.size-dy = 0px;
                                }
                                if (event.kind == PointerEventKind.move && root.size-track == track.id) {
                                    root.size-dy = self.absolute-position.y + self.mouse-y - root.size-ay;
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.size-track == track.id) {
                                    if (abs(root.size-dy) > 2px) {
                                        root.set-track-height(track.id, max(18px, track.clip-size * root.row-height + root.size-dy) / root.row-height);
                                    }
                                    root.size-track = -1;
                                    root.size-dy = 0px;
                                }
                            }
                            double-clicked => {
                                root.set-track-height(track.id, 1);
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hint = "track height: drag the bottom edge · double click for the others' height · Ctrl and the wheel over the headers for all";
                                } else if (root.hint == "track height: drag the bottom edge · double click for the others' height · Ctrl and the wheel over the headers for all") {
                                    root.hint = "";
                                }
                            }
                        }
                    }
                    // Under the last track: how to make another.
                    Rectangle {
                        y: root.rows-height + lanes.content-y + 6px;
                        x: 10px;
                        width: 110px;
                        height: 26px;
                        new-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Empty track";
                                    activated => {
                                        root.command("track.add");
                                    }
                                }
                                MenuItem {
                                    title: "From a sound file…";
                                    activated => {
                                        root.command("import");
                                    }
                                }
                                for entry[at] in root.timeline-entries: MenuItem {
                                    title: entry.label;
                                    activated => {
                                        root.menu-entry("timeline", at, root.selected, -1);
                                    }
                                }
                            }
                            Button {
                                width: parent.width;
                                icon: Icons.ph-plus;
                                icon-box: 256;
                                label: "New track";
                                quiet: true;
                                clicked => {
                                    new-menu.show({ x: 0, y: self.height + 2px });
                                }
                            }
                        }
                    }
                }

                // Zoom, in the corner of the timeline: in time, the whole
                // song, and the height of the tracks.
                Rectangle {
                    z: 10;
                    x: parent.width - self.width - 14px;
                    y: parent.height - self.height - 14px;
                    width: zoom-row.preferred-width;
                    height: 28px;
                    border-radius: 4px;
                    background: Theme.card.with-alpha(0.96);
                    border-width: 1px;
                    border-color: Theme.card-line;
                    property <bool> over: zoom-out.has-hover || zoom-in.has-hover || zoom-all.has-hover || rows-less.has-hover || rows-more.has-hover;
                    changed over => {
                        if (self.over) {
                            root.hint = "zoom: − and + in time (Ctrl − and Ctrl +, or Ctrl and the wheel) · Fit shows the whole song (Ctrl 0) · the arrows make tracks shorter and taller (Ctrl ↑ ↓, or Alt and the wheel)";
                        } else if (root.hint == "zoom: − and + in time (Ctrl − and Ctrl +, or Ctrl and the wheel) · Fit shows the whole song (Ctrl 0) · the arrows make tracks shorter and taller (Ctrl ↑ ↓, or Alt and the wheel)") {
                            root.hint = "";
                        }
                    }
                    zoom-row := HorizontalLayout {
                        padding: 2px;
                        spacing: 1px;
                        zoom-out := Button {
                            icon: Icons.ph-magnifying-glass-minus;
                            icon-box: 256;
                            height: 24px;
                            quiet: true;
                            clicked => {
                                root.zoom-step(false);
                            }
                        }
                        zoom-in := Button {
                            icon: Icons.ph-magnifying-glass-plus;
                            icon-box: 256;
                            height: 24px;
                            quiet: true;
                            clicked => {
                                root.zoom-step(true);
                            }
                        }
                        zoom-all := Button {
                            label: "Fit";
                            height: 24px;
                            quiet: true;
                            clicked => {
                                root.zoom-fit();
                            }
                        }
                        Rectangle {
                            width: 1px;
                            background: Theme.card-line;
                        }
                        rows-less := Button {
                            icon: Icons.ph-arrows-in-line-vertical;
                            icon-box: 256;
                            height: 24px;
                            quiet: true;
                            clicked => {
                                root.zoom-rows(false);
                            }
                        }
                        rows-more := Button {
                            icon: Icons.ph-arrows-out-line-vertical;
                            icon-box: 256;
                            height: 24px;
                            quiet: true;
                            clicked => {
                                root.zoom-rows(true);
                            }
                        }
                    }
                }

                // The timeline.
                lanes := ScrollView {
                    x: root.header-width;
                    y: root.ruler-height;
                    width: parent.width - root.header-width;
                    height: parent.height - root.ruler-height;
                    content-width: root.bars * root.bar * root.beat;
                    content-height: root.rows-height + 40px;

                    for track[index] in root.tracks: Rectangle {
                        x: root.seen-x(0px);
                        y: track.top * root.row-height;
                        width: root.seen-w(0px, lanes.content-width);
                        height: track.size * root.row-height - 1px;
                        background: track.id == root.selected ? #24262b : Math.mod(index, 2) == 0 ? Theme.lane : Theme.lane-alt;
                        Rectangle {
                            y: parent.height;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                    // Half beats and beats of the signature, when there is room
                    // for them, then bars, as the tempo map has them.
                    if root.beat >= 20px: Rectangle {
                        for line in root.ruler-lines: Rectangle {
                            x: (line.beat + line.next) / 2 * root.beat;
                            width: 1px;
                            height: root.rows-height;
                            background: Theme.line-sub;
                        }
                    }
                    if root.beat >= 10px: Rectangle {
                        for line in root.ruler-lines: Rectangle {
                            visible: line.label == "";
                            x: line.beat * root.beat;
                            width: 1px;
                            height: root.rows-height;
                            background: Theme.line-beat;
                        }
                    }
                    for line in root.ruler-lines: Rectangle {
                        visible: line.label != "";
                        x: line.beat * root.beat;
                        width: 1px;
                        height: root.rows-height;
                        background: Theme.line-bar;
                    }
                    // The loop, faintly, while it is on.
                    if root.looping: Rectangle {
                        x: root.seen-x(root.loop-start * root.beat);
                        width: root.seen-w(root.loop-start * root.beat, (root.loop-end - root.loop-start) * root.beat);
                        height: root.rows-height;
                        background: #fec13a10;
                    }
                    // The lanes themselves: a click puts the cursor, a double
                    // click makes a clip, a drag selects a stretch of time.
                    lane-menu := ContextMenuArea {
                        width: lanes.content-width;
                        height: lanes.content-height;
                        Menu {
                            MenuItem {
                                title: "New clip here";
                                activated => {
                                    root.command("clip.add");
                                }
                            }
                            MenuItem {
                                title: "Import a sound file…";
                                activated => {
                                    root.command("import");
                                }
                            }
                            MenuItem {
                                title: "Paste";
                                activated => {
                                    root.feed("P");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "Marker here";
                                activated => {
                                    root.command("marker at=" + max(0, lane-touch.menu-x / root.beat));
                                }
                            }
                            MenuItem {
                                title: "Region over the selection or the loop";
                                activated => {
                                    root.command("region");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "New track";
                                activated => {
                                    root.command("track.add");
                                }
                            }
                            for entry[at] in root.timeline-entries: MenuItem {
                                title: entry.label;
                                activated => {
                                    root.menu-entry("timeline", at, root.selected, lane-touch.menu-x / root.beat);
                                }
                            }
                        }
                        lane-touch := TouchArea {
                            property <bool> dragging: self.pressed && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > root.row-height / 2);
                            property <length> menu-x;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    keys.focus();
                                    root.renaming = -1;
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.select-track(root.tracks[root.row-at(self.mouse-y)].id, self.mouse-x / root.beat);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.marquee-press(self.mouse-x, self.mouse-y);
                                }
                                if (event.kind == PointerEventKind.move) {
                                    root.marquee-move(self.mouse-x, self.mouse-y);
                                    root.pan-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                    root.pan-press(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                                    root.panning = false;
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right
                                    && !root.marquee-release(event.modifiers.shift, event.modifiers.control)) {
                                    // A right click also puts the cursor, so that the menu acts there.
                                    root.select-track(root.tracks[root.row-at(self.mouse-y)].id, self.mouse-x / root.beat);
                                    self.menu-x = self.mouse-x;
                                    lane-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left
                                    && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > root.row-height / 2)) {
                                    root.select-range(
                                        root.row-at(min(self.pressed-y, self.mouse-y)) + 1, self.pressed-x / root.beat,
                                        root.row-at(max(self.pressed-y, self.mouse-y)) + 1, self.mouse-x / root.beat);
                                }
                            }
                            double-clicked => {
                                root.add-clip-at(
                                    root.tracks[root.row-at(self.mouse-y)].id,
                                    self.mouse-x / root.beat);
                            }
                            scroll-event(event) => {
                                if (event.modifiers.control) {
                                    root.zoom-timeline(event.delta-y, self.mouse-x);
                                    return accept;
                                }
                                if (event.modifiers.shift) {
                                    // Sideways, for a wheel that only turns one way.
                                    lanes.content-x = clamp(lanes.content-x + event.delta-y, min(0px, lanes.width - lanes.content-width), 0px);
                                    return accept;
                                }
                                if (event.modifiers.alt) {
                                    root.zoom-rows(event.delta-y > 0);
                                    return accept;
                                }
                                reject
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                root.hint = "timeline: click puts the cursor · double click makes a clip · drag selects time · right drag chooses clips · middle drag pans · Ctrl and wheel zooms";
                            } else if (root.hint == "timeline: click puts the cursor · double click makes a clip · drag selects time · right drag chooses clips · middle drag pans · Ctrl and wheel zooms") {
                                root.hint = "";
                            }
                            }
                        }
                    }
                    for clip in root.clips: clip-box := Rectangle {
                        // How far the clip has been dragged or stretched, until
                        // it is let go.
                        property <length> dx: 0px;
                        property <length> dy: 0px;
                        property <length> dw: 0px;
                        property <bool> current: clip.id == root.selected-clip;
                        property <bool> hover: clip-touch.has-hover || edge-touch.has-hover || ledge-touch.has-hover;
                        // A title bar when the row has room for one.
                        property <length> title: root.row-clip(clip.track) >= 40px ? 16px : 0px;
                        // Carried along by a drag of this clip, or of another chosen one.
                        property <bool> dragged: root.drag-clip >= 0 && (clip.id == root.drag-clip || (root.drag-group && clip.selected));
                        // An edge of it being dragged, or of another chosen one.
                        property <bool> trimmed: root.trim-clip >= 0 && (clip.id == root.trim-clip || (root.trim-group && clip.selected));
                        property <length> trim-left: self.trimmed && !root.trim-slip && root.trim-start ? max(root.trim-shown, -clip.start * root.beat) : 0px;
                        property <length> trim-right: self.trimmed && !root.trim-slip && !root.trim-start ? root.trim-shown : 0px;
                        z: self.dragged ? 1 : 0;
                        // Where the whole clip is, and the part of it that shows,
                        // which is what is drawn: `cut-left` and `cut-right` are
                        // how much of it lies beyond that on either side.
                        property <length> true-x: clip.start * root.beat + (self.dragged ? root.drag-shown-dx : self.trim-left);
                        property <length> true-w: max(6px, clip.length * root.beat - 1px - self.trim-left + self.trim-right);
                        property <length> cut-left: self.x - self.true-x;
                        property <length> cut-right: self.true-x + self.true-w - self.x - self.width;
                        x: root.seen-x(self.true-x);
                        y: root.row-top(clip.track) + 1px + (self.dragged ? root.drag-shown-dy : self.dy);
                        width: root.seen-w(self.true-x, self.true-w);
                        height: root.row-clip(clip.track) - 3px;
                        border-radius: 2px;
                        clip: true;
                        background: clip.muted ? Theme.panel : clip.color.mix(Theme.lane, self.current ? 0.40 : 0.26);
                        // The name, on the track's colour.
                        if clip-box.title > 0: Rectangle {
                            y: 0;
                            height: clip-box.title;
                            background: clip.muted ? Theme.text-off : parent.current ? clip.color.mix(white, 0.80) : clip.color;
                            Text {
                                // The name stays in view while the clip's start is out of it.
                                x: max(5px, -lanes.content-x - clip-box.x + 5px);
                                width: parent.width - self.x - 3px;
                                text: clip.takes > 1 ? clip.name + "  ‹" + clip.take + "/" + clip.takes + "›" : clip.name;
                                color: clip.muted ? Theme.text-3 : Theme.on-hue;
                                font-weight: 600;
                                font-size: Theme.t-small;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        // Its notes, or its waveform.
                        Image {
                            // What plays moves with the pointer while it is slipped, and stays
