                                y: 0;
                                width: 9px;
                                height: 9px;
                                border-radius: 2px;
                                background: fade-touch.has-hover || root.fade-clip == clip.id ? Theme.select : Theme.text.with-alpha(0.6);
                                fade-touch := TouchArea {
                                    mouse-cursor: ew-resize;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            keys.focus();
                                            root.fade-clip = clip.id;
                                            root.fade-out = parent.is-out;
                                            root.fade-ax = self.absolute-position.x + self.mouse-x;
                                            root.fade-dx = 0px;
                                        }
                                        if (event.kind == PointerEventKind.move && root.fade-clip == clip.id) {
                                            root.fade-dx = self.absolute-position.x + self.mouse-x - root.fade-ax;
                                        }
                                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.fade-clip == clip.id) {
                                            if (abs(root.fade-dx) > 1px) {
                                                root.set-fade(clip.id, parent.is-out, (parent.is-out ? clip-box.fade-out-x : clip-box.fade-in-x) / root.beat);
                                            }
                                            root.fade-clip = -1;
                                            root.fade-dx = 0px;
                                        }
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.hint = "fade: drag sideways to make it longer or shorter";
                                        } else if (root.hint == "fade: drag sideways to make it longer or shorter") {
                                            root.hint = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // While a take is made: what has been recorded so far.
                    if root.recording: Rectangle {
                        for track[index] in root.tracks: Rectangle {
                            visible: track.armed;
                            x: root.seen-x(root.rec-start * root.beat);
                            y: track.top * root.row-height + 1px;
                            width: max(2px, root.seen-w(root.rec-start * root.beat, (root.position - root.rec-start) * root.beat));
                            height: track.clip-size * root.row-height - 3px;
                            border-radius: 2px;
                            background: Theme.rec.with-alpha(0.3);
                            border-width: 1px;
                            border-color: Theme.rec;
                        }
                    }
                    // Automation, over the clips while it is being edited: one
                    // lane a track. Draw with the pointer held down.
                    if root.show-automation: Rectangle {
                        x: 0;
                        y: 0;
                        width: lanes.content-width;
                        height: root.rows-height;
                        Rectangle {
                            x: root.seen-x(0px);
                            width: root.seen-w(0px, lanes.content-width);
                            background: Theme.surface.with-alpha(0.6);
                        }
                        auto-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Clear this lane";
                                    activated => {
                                        root.lane-command(root.row-at(auto-touch.pressed-y), "clear");
                                    }
                                }
                                MenuItem {
                                    title: "Turn this lane off or on";
                                    activated => {
                                        root.lane-command(root.row-at(auto-touch.pressed-y), "toggle");
                                    }
                                }
                            }
                            auto-touch := TouchArea {
                                property <int> lane-row: root.row-at(self.pressed-y);
                                pure function height-at(y: length) -> float {
                                    clamp(1 - (y - root.row-top(self.lane-row)) / root.row-clip(self.lane-row), 0, 1)
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        keys.focus();
                                        root.pencil(self.lane-row, self.mouse-x / root.beat, self.height-at(self.mouse-y), 0);
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                        root.pencil(self.lane-row, self.mouse-x / root.beat, self.height-at(self.mouse-y), 2);
                                    }
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        auto-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.pencil(self.lane-row, self.mouse-x / root.beat, self.height-at(self.mouse-y), 1);
                                    }
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hint = "automation: click adds a point · hold and draw a curve · drag a point to move it · right click a point removes it";
                                    } else if (root.hint == "automation: click adds a point · hold and draw a curve · drag a point to move it · right click a point removes it") {
                                        root.hint = "";
                                    }
                                }
                            }
                        }
                        // What each lane moves, at the left of what shows.
                        for lane in root.lanes: Text {
                            x: -lanes.content-x + 8px;
                            y: root.row-top(lane.row) + 3px;
                            text: lane.enabled ? lane.name : lane.name + " (off)";
                            color: lane.enabled ? root.tracks[lane.row].color.mix(white, 0.7) : Theme.text-3;
                            font-size: Theme.t-small;
                            font-weight: 600;
                        }
                        if root.pencil-row >= 0: Path {
                            // Only the stretch that shows is drawn: see `seen-x`.
                            x: root.seen-x(0px);
                            y: root.row-top(root.pencil-row);
                            width: root.seen-w(0px, lanes.content-width);
                            height: root.row-size(root.pencil-row);
                            clip: true;
                            viewbox-x: self.x / 1px;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: root.pencil-path;
                            stroke: Theme.text;
                            stroke-width: 2px;
                        }
                        for lane in root.lanes: Path {
                            x: root.seen-x(0px);
                            y: root.row-top(lane.row);
                            width: root.seen-w(0px, lanes.content-width);
                            height: root.row-size(lane.row);
                            clip: true;
                            viewbox-x: self.x / 1px;
                            viewbox-y: 0;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: lane.path;
                            stroke: lane.enabled ? root.tracks[lane.row].color.mix(white, 0.7) : Theme.text-3;
                            stroke-width: 1.5px;
                        }
                        for point in root.points: Rectangle {
                            property <length> dx: 0px;
                            property <length> dy: 0px;
                            x: point.beat * root.beat - 5px + self.dx;
                            y: root.row-top(point.row) + (point.top + (1 - point.value) * point.span) * root.row-height - 5px + self.dy;
                            width: 10px;
                            height: 10px;
                            Rectangle {
                                x: handle.has-hover || handle.pressed ? 1px : 2px;
                                y: self.x;
                                width: parent.width - 2 * self.x;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: handle.pressed ? Theme.select : handle.has-hover ? white : Theme.text;
                            }
                            handle := TouchArea {
                                moved => {
                                    if (self.pressed) {
                                        parent.dx += self.mouse-x - self.pressed-x;
                                        parent.dy += self.mouse-y - self.pressed-y;
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        root.move-point(
                                            point.lane, point.index,
                                            point.beat + parent.dx / root.beat,
                                            clamp(point.value - parent.dy / (point.span * root.row-height), 0, 1));
                                        parent.dx = 0px;
                                        parent.dy = 0px;
                                    }
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        root.remove-point(point.lane, point.index);
                                    }
                                }
                            }
                        }
                    }
                    // Lanes shown as rows of their own, under the clips of their
                    // tracks: always there to draw on with the pointer held down.
                    for strip in root.strips: strip-box := Rectangle {
                        x: 0;
                        y: root.row-top(strip.row) + strip.top * root.row-height;
                        width: lanes.content-width;
                        height: strip.span * root.row-height - 1px;
                        Rectangle {
                            x: root.seen-x(0px);
                            width: root.seen-w(0px, lanes.content-width);
                            background: Theme.panel.with-alpha(0.7);
                            Rectangle {
                                y: 0;
                                height: 1px;
                                background: Theme.divider;
                            }
                        }
                        strip-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Clear this lane";
                                    activated => {
                                        root.lane-id-command(strip.id, "clear");
                                    }
                                }
                                MenuItem {
                                    title: strip.enabled ? "Turn this lane off" : "Turn this lane on";
                                    activated => {
                                        root.lane-id-command(strip.id, "toggle");
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Hide the track's lane rows";
                                    activated => {
                                        root.lane-id-command(strip.id, "hide");
                                    }
                                }
                            }
                            strip-touch := TouchArea {
                                pure function height-at(y: length) -> float {
                                    clamp(1 - y / self.height, 0, 1)
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        keys.focus();
                                        root.strip-pencil(strip.id, self.mouse-x / root.beat, self.height-at(self.mouse-y), 0);
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                        root.strip-pencil(strip.id, self.mouse-x / root.beat, self.height-at(self.mouse-y), 2);
                                    }
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                        strip-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.strip-pencil(strip.id, self.mouse-x / root.beat, self.height-at(self.mouse-y), 1);
                                    }
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hint = "lane: click adds a point · hold and draw a curve · drag a point to move it · right click a point removes it";
                                    } else if (root.hint == "lane: click adds a point · hold and draw a curve · drag a point to move it · right click a point removes it") {
                                        root.hint = "";
                                    }
                                }
                            }
                        }
                        // What it moves, at the left of what shows.
                        Text {
                            x: -lanes.content-x + 8px;
                            y: 2px;
                            text: strip.enabled ? strip.name : strip.name + " (off)";
                            color: strip.enabled ? root.tracks[strip.row].color.mix(white, 0.7) : Theme.text-3;
                            font-size: Theme.t-small;
                            font-weight: 600;
                        }
                        Path {
                            x: root.seen-x(0px);
                            width: root.seen-w(0px, lanes.content-width);
                            clip: true;
                            viewbox-x: self.x / 1px;
                            viewbox-y: 0;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: strip.path;
                            stroke: strip.enabled ? root.tracks[strip.row].color.mix(white, 0.7) : Theme.text-3;
                            stroke-width: 1.5px;
                        }
                        if root.strip-pencil-lane == strip.id: Path {
                            x: root.seen-x(0px);
                            width: root.seen-w(0px, lanes.content-width);
                            clip: true;
                            viewbox-x: self.x / 1px;
                            viewbox-y: 0;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: root.strip-pencil-path;
                            stroke: Theme.text;
                            stroke-width: 2px;
                        }
                    }
                    for point in root.strip-points: Rectangle {
                        property <length> dx: 0px;
                        property <length> dy: 0px;
                        x: point.beat * root.beat - 5px + self.dx;
                        y: root.row-top(point.row) + (point.top + (1 - point.value) * point.span) * root.row-height - 5px + self.dy;
                        width: 10px;
                        height: 10px;
                        Rectangle {
                            x: strip-handle.has-hover || strip-handle.pressed ? 1px : 2px;
                            y: self.x;
                            width: parent.width - 2 * self.x;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: strip-handle.pressed ? Theme.select : strip-handle.has-hover ? white : Theme.text;
                        }
                        strip-handle := TouchArea {
                            moved => {
                                if (self.pressed) {
                                    parent.dx += self.mouse-x - self.pressed-x;
                                    parent.dy += self.mouse-y - self.pressed-y;
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    root.move-point(
                                        point.lane, point.index,
                                        point.beat + parent.dx / root.beat,
                                        clamp(point.value - parent.dy / (point.span * root.row-height), 0, 1));
                                    parent.dx = 0px;
                                    parent.dy = 0px;
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.remove-point(point.lane, point.index);
                                }
                            }
                        }
                    }
                    // What is selected: by a drag here, or by visual mode.
                    if root.sel-open && root.focused == "arrange" && root.sel-kind != "clips": Rectangle {
                        x: root.sel-kind == "line" ? root.seen-x(0px) : root.seen-x(root.sel-start * root.beat);
                        y: root.row-top(root.sel-row);
                        width: root.sel-kind == "line" ? root.seen-w(0px, lanes.content-width) : root.seen-w(root.sel-start * root.beat, (root.sel-end - root.sel-start) * root.beat);
                        height: root.row-top(root.sel-row + root.sel-rows) - root.row-top(root.sel-row) - 1px;
                        background: Theme.select.with-alpha(0.22);
                        border-width: 1px;
                        border-color: Theme.select;
                        selection-menu := ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Delete";
                                    activated => {
                                        root.feed("d");
                                    }
                                }
                                MenuItem {
                                    title: "Copy";
                                    activated => {
                                        root.feed("y");
                                    }
                                }
                                MenuItem {
                                    title: "Loop this stretch";
                                    activated => {
                                        root.feed("gl");
                                    }
                                }
                                MenuItem {
                                    title: "Mute or unmute";
                                    activated => {
                                        root.feed("~");
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: "Let go";
                                    activated => {
                                        root.feed("<Esc>");
                                    }
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.feed("<Esc>");
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                        selection-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                                changed has-hover => {
                                    if (self.has-hover) {
                                root.hint = "selection: right click to delete, copy, loop or mute it · click to let go · Delete removes it";
                            } else if (root.hint == "selection: right click to delete, copy, loop or mute it · click to let go · Delete removes it") {
                                root.hint = "";
                            }
                                }
                            }
                        }
                    }
                    // A box being drawn with the right button.
                    if root.marquee && root.marquee-moved: Rectangle {
                        x: min(root.mq-x0, root.mq-x1);
                        y: min(root.mq-y0, root.mq-y1);
                        width: abs(root.mq-x1 - root.mq-x0);
                        height: abs(root.mq-y1 - root.mq-y0);
                        background: Theme.select-fill;
                        border-width: 1px;
                        border-color: Theme.select;
                    }
                    // While a selection is being dragged out.
                    if lane-touch.dragging: Rectangle {
                        x: min(lane-touch.pressed-x, lane-touch.mouse-x);
                        y: root.row-top(root.row-at(min(lane-touch.pressed-y, lane-touch.mouse-y)));
                        width: abs(lane-touch.mouse-x - lane-touch.pressed-x);
                        height: root.row-top(root.row-at(max(lane-touch.pressed-y, lane-touch.mouse-y)) + 1) - root.row-top(root.row-at(min(lane-touch.pressed-y, lane-touch.mouse-y))) - 1px;
                        background: Theme.select.with-alpha(0.18);
                        border-width: 1px;
                        border-color: Theme.select;
                    }
                    // Edit cursor and playhead.
                    Rectangle {
                        x: root.cursor * root.beat;
                        y: 0;
                        width: 1px;
                        height: root.rows-height;
                        background: Theme.select;
                    }
                    if root.cursor-row >= 0 && !root.sel-open: Rectangle {
                        x: root.cursor * root.beat;
                        y: root.row-top(root.cursor-row);
                        width: max(3px, root.grid * root.beat);
                        height: root.row-size(root.cursor-row) - 1px;
                        background: Theme.text.with-alpha(0.10);
                        border-width: root.focused == "arrange" ? 1px : 0px;
                        border-color: Theme.mode-color(root.mode);
                    }
                    Rectangle {
                        x: root.position * root.beat;
                        y: 0;
                        width: 1px;
                        height: root.rows-height;
                        background: Theme.play;
                    }
                }

                // With no tracks yet: how to begin.
                if root.tracks.length <= 1: Rectangle {
                    x: root.header-width + 60px;
                    y: root.ruler-height + 110px;
                    width: 420px;
                    height: 150px;
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "A new project";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                        }
                        Text {
                            text: "Press “New track”, put an instrument on it from the panel on the right, then double click in its lane to make a clip and again on the clip to write notes.";
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "The space bar plays. Every key of the terminal interface works here too; ? lists them.";
                            color: Theme.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.divider;
            }

            // The selected track: its name, then its devices.
            Rectangle {
                width: 300px;
                background: Theme.panel;
                VerticalLayout {
                    spacing: 0px;
                    // Its name, on a stripe of its colour.
                    Rectangle {
                        height: 40px;
                        Rectangle {
                            x: 0;
                            width: 4px;
                            background: root.selected >= 0 ? root.selected-color : Theme.text-off;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 8px;
                            Text {
                                text: root.selected-name == "" ? "No track selected" : root.selected-name;
                                color: root.selected-name == "" ? Theme.text-3 : Theme.text;
                                font-size: Theme.t-title;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.devices.length == 1 ? "1 device" : root.devices.length + " devices";
                                color: Theme.text-3;
                                font-size: Theme.t-small;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        vertical-stretch: 1;
                        // Add a device by typing part of its name.
                        Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: Theme.well;
                            border-width: 1px;
                            border-color: search.has-focus ? Theme.select : transparent;
                            Icon {
                                x: 8px;
                                y: 7px;
                                width: 14px;
                                height: 14px;
                                box: 256;
                                shape: Icons.ph-plus;
                                ink: Theme.text-3;
                            }
                            if search.text == "": Text {
                                x: 28px;
                                width: parent.width - 36px;
                                text: root.selected >= 0 ? "Add a device: its name, @instrument, @fav" : "Select a track to add devices";
                                color: Theme.text-3;
                                font-size: Theme.t-base;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            search := TextInput {
                                x: 28px;
                                width: parent.width - 36px;
                                height: parent.height;
                                color: Theme.text;
                                font-size: Theme.t-base;
                                selection-background-color: Theme.select.with-alpha(0.4);
                                vertical-alignment: center;
                                single-line: true;
                                enabled: root.selected >= 0;
                                edited => {
                                    root.search-devices(self.text);
                                }
                                accepted => {
                                    if (root.device-matches.length > 0) {
                                        root.add-device(root.device-matches[0]);
                                        self.text = "";
                                        root.search-devices("");
                                        keys.focus();
                                    }
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        self.text = "";
                                        root.search-devices("");
                                        keys.focus();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                        if root.device-matches.length > 0: Rectangle {
                            height: min(190px, root.device-matches.length * 24px + 8px);
                            border-radius: 4px;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.card-line;
                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    padding: 4px;
                                    for match[at] in root.device-matches: Rectangle {
                                        height: 24px;
                                        border-radius: 3px;
                                        background: pick.has-hover ? Theme.select.with-alpha(0.25) : at == 0 ? Theme.hover-face : transparent;
                                        Text {
                                            x: 26px;
                                            text: match;
                                            color: Theme.text;
                                            font-size: Theme.t-base;
                                            vertical-alignment: center;
                                            height: parent.height;
                                            overflow: elide;
                                            width: parent.width - 34px;
                                        }
                                        // Mark it a favourite: favourites are listed first.
                                        Rectangle {
                                            x: 0px;
                                            width: 22px;
                                            height: parent.height;
                                            Text {
                                                text: "☆";
                                                color: star.has-hover ? Theme.warn : Theme.text-3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            star := TouchArea {
                                                clicked => {
                                                    root.toggle-favourite(match);
                                                }
                                            }
                                        }
                                        pick := TouchArea {
                                            x: 22px;
                                            width: parent.width - 22px;
                                            clicked => {
                                                root.add-device(match);
                                                search.text = "";
                                                root.search-devices("");
                                                keys.focus();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Where the track's sound goes: the track it plays
                        // into, and the tracks it is sent to as well.
                        if root.selected >= 0 && !root.route-master: Rectangle {
                            border-radius: 4px;
                            background: Theme.card;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 22px;
                                    Text {
                                        text: "OUTPUT";
                                        color: Theme.text-3;
                                        font-size: Theme.t-micro;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        width: 46px;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 3px;
                                        background: out-touch.has-hover ? Theme.control-hover : Theme.control;
                                        Text {
                                            x: 8px;
                                            width: parent.width - 28px;
                                            text: root.route-output;
                                            color: Theme.text;
                                            font-size: Theme.t-base;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        Icon {
                                            x: parent.width - 18px;
                                            y: (parent.height - 12px) / 2;
                                            width: 12px;
                                            height: 12px;
                                            box: 256;
                                            shape: Icons.ph-caret-down;
                                            ink: Theme.text-2;
                                        }
                                        out-menu := ContextMenuArea {
                                            Menu {
                                                for name[at] in root.route-targets: MenuItem {
                                                    title: name;
                                                    checked: name == root.route-output;
                                                    activated => {
                                                        root.choose-output(at);
                                                    }
                                                }
                                            }
                                            out-touch := TouchArea {
                                                clicked => {
                                                    out-menu.show({ x: 0px, y: self.height });
                                                }
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.hint = "output: the track this one plays into; a bus or a group takes several";
                                                    } else if (root.hint == "output: the track this one plays into; a bus or a group takes several") {
                                                        root.hint = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 62px;
                                        border-radius: 3px;
                                        background: send-touch.has-hover ? Theme.control-hover : Theme.control;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    width: 12px;
                                                    height: 12px;
                                                    box: 256;
                                                    shape: Icons.ph-plus;
                                                    ink: Theme.text-2;
                                                }
                                            }
                                            Text {
                                                text: "Send";
                                                color: Theme.text;
                                                font-size: Theme.t-base;
                                                vertical-alignment: center;
                                            }
                                        }
                                        send-menu := ContextMenuArea {
                                            Menu {
                                                for name[at] in root.route-targets: MenuItem {
                                                    title: name;
                                                    enabled: at > 0;
                                                    activated => {
                                                        root.add-send(at);
                                                    }
                                                }
                                            }
                                            send-touch := TouchArea {
                                                clicked => {
                                                    send-menu.show({ x: 0px, y: self.height });
                                                }
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.hint = "send: also feed this track's sound to another, a reverb for one, at a level of its own";
                                                    } else if (root.hint == "send: also feed this track's sound to another, a reverb for one, at a level of its own") {
                                                        root.hint = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                for send[at] in root.route-sends: HorizontalLayout {
                                    spacing: 6px;
                                    height: 22px;
                                    Text {
                                        text: "→ " + send.name;
                                        color: Theme.text-2;
                                        font-size: Theme.t-small;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        width: 64px;
                                    }
                                    Slider {
                                        value: send.value;
                                        horizontal-stretch: 1;
                                        bar: true;
                                        moved(value) => {
                                            root.set-send(at, value);
                                        }
                                        reset => {
                                            root.set-send(at, 60 / 66);
                                        }
                                    }
                                    Text {
                                        text: send.text;
                                        color: Theme.text-2;
                                        font-family: Theme.mono;
                                        font-size: Theme.t-small;
                                        font-weight: 500;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        width: 58px;
                                    }
                                    Flag {
                                        label: "pre";
                                        width: 28px;
                                        y: 2px;
                                        on: send.pre;
                                        lit: Theme.select;
                                        clicked => {
                                            root.toggle-send-pre(at);
                                        }
                                    }
                                    Button {
                                        icon: Icons.ph-x;
                                        icon-box: 256;
                                        height: 20px;
                                        y: 1px;
                                        quiet: true;
                                        clicked => {
                                            root.remove-send(at);
                                        }
                                    }
                                }
                            }
                        }
                        if root.devices.length == 0 && root.selected >= 0 && root.device-matches.length == 0: Text {
                            text: "Nothing on this track yet. Type “synth”, “drums” or the name of a plugin above.";
                            color: Theme.text-3;
                            font-size: Theme.t-small;
                            wrap: word-wrap;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 8px;
                                for device[at] in root.devices: card := Rectangle {
                                    // Where the card is in the list, for dropping a dragged one.
                                    init => {
                                        root.card-place(at, self.y / 1px, self.height / 1px);
                                    }
                                    changed y => {
                                        root.card-place(at, self.y / 1px, self.height / 1px);
                                    }
                                    changed height => {
                                        root.card-place(at, self.y / 1px, self.height / 1px);
                                    }
                                    border-radius: 4px;
                                    background: Theme.card;
                                    border-width: root.focused == "devices" && root.row-device == at + 1 ? 1px : 0px;
                                    border-color: Theme.select;
                                    VerticalLayout {
                                        // Its header: on or off, the name, and what can be done with it.
                                        HorizontalLayout {
                                            height: 26px;
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            spacing: 2px;
                                            Button {
                                                icon: Icons.ph-power;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                on: !device.bypass;
                                                idle-ink: Theme.text-3;
                                                clicked => {
                                                    root.toggle-bypass(device.id);
                                                }
                                            }
                                            // The name is also a handle: dragged onto a track's
                                            // header it moves the device there (Ctrl copies it),
                                            // dragged up or down the list it reorders the chain.
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                Text {
                                                    x: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: device.name;
                                                    color: name-drag.dragging ? Theme.select : device.status == "missing" ? Theme.warn : device.status == "offline" || device.status == "loading" || device.bypass ? Theme.text-3 : device.stopped != "" ? Theme.error : Theme.text;
                                                    font-weight: 600;
                                                    font-size: Theme.t-base;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                name-drag := TouchArea {
                                                    property <bool> dragging;
                                                    mouse-cursor: self.dragging ? MouseCursor.grabbing : MouseCursor.grab;
                                                    moved => {
                                                        if (self.pressed && abs(self.mouse-y - self.pressed-y) + abs(self.mouse-x - self.pressed-x) > 6px) {
                                                            self.dragging = true;
                                                            root.hint = "drop on a track's header to move the device there (Ctrl copies it), or up or down here to reorder";
                                                        }
                                                    }
                                                    pointer-event(event) => {
                                                        if (event.kind == PointerEventKind.up && self.dragging) {
                                                            self.dragging = false;
                                                            root.hint = "";
                                                            if (self.absolute-position.x + self.mouse-x < headers.absolute-position.x + headers.width
                                                                    && self.absolute-position.y + self.mouse-y >= headers.absolute-position.y) {
                                                                root.drop-device(device.id, root.tracks[Math.floor((self.absolute-position.y + self.mouse-y - headers.absolute-position.y - lanes.content-y) / root.row-height)].id, -1, event.modifiers.control);
                                                            } else {
                                                                root.drop-device(device.id, -1, (card.y + 4px + self.mouse-y) / 1px, event.modifiers.control);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if device.format != "builtin": Text {
                                                text: device.format;
                                                color: Theme.text-3;
                                                font-size: Theme.t-micro;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            if device.has-editor: Button {
                                                icon: Icons.ph-arrow-square-out;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                on: device.editor-open;
                                                clicked => {
                                                    root.toggle-editor(device.id);
                                                }
                                            }
                                            // Take a plugin offline: kept with its state, not run.
                                            if device.format != "builtin" && device.status != "offline": Button {
                                                icon: Icons.ph-plugs;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                clicked => {
                                                    root.toggle-offline(device.id);
                                                }
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.hint = "offline: stop running this plugin and keep it with its saved state";
                                                    } else if (root.hint == "offline: stop running this plugin and keep it with its saved state") {
                                                        root.hint = "";
                                                    }
                                                }
                                            }
                                            Button {
                                                icon: Icons.ph-caret-up;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                enabled: at > 0;
                                                clicked => {
                                                    root.move-device(device.id, -1);
                                                }
                                            }
                                            Button {
                                                icon: Icons.ph-caret-down;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                enabled: at < root.devices.length - 1;
                                                clicked => {
                                                    root.move-device(device.id, 1);
                                                }
                                            }
                                            Button {
                                                icon: Icons.ph-x;
                                                icon-box: 256;
                                                height: 22px;
                                                y: 2px;
                                                quiet: true;
                                                clicked => {
                                                    root.remove-device(device.id);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.divider.with-alpha(0.6);
                                        }
                                        // The preset: the one loaded, a step either way, and a menu of them.
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            padding-top: 4px;
                                            spacing: 2px;
                                            height: 26px;
                                            Button {
                                                label: "◀";
                                                height: 20px;
                                                quiet: true;
                                                clicked => {
                                                    root.preset-step(device.id, -1);
                                                }
                                            }
                                            preset-menu := ContextMenuArea {
                                                horizontal-stretch: 1;
                                                Menu {
                                                    for name[index] in root.preset-names: MenuItem {
                                                        title: name;
                                                        activated => {
                                                            root.choose-preset(device.id, index + 1);
                                                        }
                                                    }
                                                    MenuItem {
                                                        title: "Save as a preset…";
                                                        activated => {
                                                            root.device-command(device.id, "preset.save");
                                                        }
                                                    }
                                                    MenuItem {
                                                        title: "New ones start from this preset";
                                                        activated => {
                                                            root.device-command(device.id, "preset.default");
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: preset-touch.has-hover ? Theme.hover-face : Theme.well;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        text: (device.preset == "" ? "No preset" : device.preset) + "  ▾";
                                                        color: device.preset == "" ? Theme.text-3 : Theme.text;
                                                        font-size: Theme.t-small;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    preset-touch := TouchArea {
                                                        clicked => {
                                                            root.fill-preset-menu(device.id);
                                                            preset-menu.show({ x: 0px, y: self.height });
                                                        }
                                                    }
                                                }
                                            }
                                            Button {
                                                label: "▶";
                                                height: 20px;
                                                quiet: true;
                                                clicked => {
                                                    root.preset-step(device.id, 1);
                                                }
                                            }
                                        }
                                        // Where its further output pairs play, for a device with several.
                                        if device.pairs > 1: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            height: 22px;
                                            Text {
                                                text: "Outs";
                                                color: Theme.text-3;
                                                font-size: Theme.t-small;
                                                vertical-alignment: center;
                                            }
                                            outs-menu := ContextMenuArea {
                                                horizontal-stretch: 1;
                                                Menu {
                                                    for pair[p] in root.output-pairs: Menu {
                                                        title: pair.label;
                                                        for entry[index] in pair.choices: MenuItem {
                                                            title: entry.label;
                                                            checked: entry.checked;
                                                            activated => {
                                                                root.route-pair(device.id, p + 2, index + 1);
                                                            }
                                                        }
                                                    }
                                                    MenuSeparator { }
                                                    MenuItem {
                                                        title: "Spread the outputs over new tracks";
                                                        activated => {
                                                            root.device-command(device.id, "device.spread");
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    y: 1px;
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: outs-touch.has-hover ? Theme.hover-face : Theme.well;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        text: device.routed + " of " + (device.pairs - 1) + " more pairs routed  ▾";
                                                        color: device.routed == 0 ? Theme.text-3 : Theme.text;
                                                        font-size: Theme.t-small;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    outs-touch := TouchArea {
                                                        clicked => {
                                                            root.fill-outputs-menu(device.id);
                                                            outs-menu.show({ x: 0px, y: self.height });
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // The track it listens to, for a device with a side-chain.
                                        if device.keyed: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            height: 22px;
                                            Text {
                                                text: "Key";
                                                color: Theme.text-3;
                                                font-size: Theme.t-small;
                                                vertical-alignment: center;
                                            }
                                            key-menu := ContextMenuArea {
                                                horizontal-stretch: 1;
                                                Menu {
                                                    for entry[index] in root.sidechain-choices: MenuItem {
                                                        title: entry.label;
                                                        checked: entry.checked;
                                                        activated => {
                                                            root.choose-sidechain(device.id, index + 1);
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    y: 1px;
                                                    height: 20px;
                                                    border-radius: 3px;
                                                    background: key-touch.has-hover ? Theme.hover-face : Theme.well;
                                                    Text {
                                                        x: 8px;
                                                        width: parent.width - 16px;
                                                        text: (device.sidechain == "" ? "Its own input" : device.sidechain) + "  ▾";
                                                        color: device.sidechain == "" ? Theme.text-3 : Theme.text;
                                                        font-size: Theme.t-small;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    key-touch := TouchArea {
                                                        clicked => {
                                                            root.fill-sidechain-menu(device.id);
                                                            key-menu.show({ x: 0px, y: self.height });
                                                        }
                                                        changed has-hover => {
                                                            if (self.has-hover) {
                                                                root.hint = "side-chain: the track this device listens to, such as a kick that ducks the bass";
                                                            } else if (root.hint == "side-chain: the track this device listens to, such as a kick that ducks the bass") {
                                                                root.hint = "";
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // The host's mix around the device: how much of it is heard, and its level.
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            height: 22px;
                                            Text {
                                                text: "Wet";
                                                color: Theme.text-3;
                                                font-size: Theme.t-small;
                                                vertical-alignment: center;
                                            }
                                            Slider {
                                                y: 3px;
                                                value: device.wet;
                                                horizontal-stretch: 1;
                                                moved(value) => {
                                                    root.set-param(device.id, "fx_wet", value);
                                                }
                                                reset => {
                                                    root.reset-param(device.id, "fx_wet");
                                                }
                                            }
                                            Text {
                                                text: Math.round(device.wet * 100) + "%";
                                                color: Theme.text;
                                                font-family: Theme.mono;
                                                font-size: Theme.t-small;
                                                width: 34px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Out";
                                                color: Theme.text-3;
                                                font-size: Theme.t-small;
                                                vertical-alignment: center;
                                            }
                                            Slider {
                                                y: 3px;
                                                value: (device.gain + 24) / 48;
                                                centred: true;
                                                horizontal-stretch: 1;
                                                moved(value) => {
                                                    root.set-param(device.id, "fx_gain", value);
                                                }
                                                reset => {
                                                    root.reset-param(device.id, "fx_gain");
                                                }
                                            }
                                            Text {
                                                text: Math.round(device.gain * 10) / 10 + " dB";
                                                color: Theme.text;
                                                font-family: Theme.mono;
                                                font-size: Theme.t-small;
                                                width: 48px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                        // A plugin being made, not installed, or offline: passed over until it runs.
                                        if device.status == "loading" || device.status == "missing" || device.status == "offline": HorizontalLayout {
                                            padding: 8px;
                                            padding-bottom: 0px;
                                            spacing: 6px;
                                            Icon {
                                                y: 2px;
                                                width: 14px;
                                                height: 14px;
                                                box: 256;
                                                shape: device.status == "missing" ? Icons.ph-warning : device.status == "offline" ? Icons.ph-plugs : Icons.ph-circle;
                                                ink: device.status == "missing" ? Theme.warn : Theme.text-3;
                                            }
                                            Text {
                                                text: device.status == "loading" ? "Loading…" : device.status == "missing" ? "Not installed: kept with its saved state" : "Offline: kept with its saved state";
                                                color: device.status == "missing" ? Theme.warn : Theme.text-2;
                                                font-size: Theme.t-small;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            if device.status == "offline": Button {
                                                label: "Online";
                                                height: 22px;
                                                clicked => {
                                                    root.toggle-offline(device.id);
                                                }
                                            }
                                        }
                                        // A plugin that crashed or hung: what happened, and a way back.
                                        if device.stopped != "" && device.status != "missing": HorizontalLayout {
                                            padding: 8px;
                                            spacing: 6px;
                                            Icon {
                                                y: 2px;
                                                width: 14px;
                                                height: 14px;
                                                box: 256;
                                                shape: Icons.ph-warning;
                                                ink: Theme.error;
                                            }
                                            Text {
                                                text: "Stopped: " + device.stopped;
                                                color: Theme.error;
                                                font-size: Theme.t-small;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Button {
                                                label: "Restart";
                                                height: 22px;
                                                clicked => {
                                                    root.restart-device(device.id);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            opacity: device.bypass ? 0.5 : 1;
                                            VerticalLayout {
                                                padding-left: 8px;
                                                padding-right: 4px;
                                                padding-top: 4px;
                                                padding-bottom: 6px;
                                                for param[row] in device.params: HorizontalLayout {
                                                    height: 22px;
                                                    spacing: 6px;
                                                    property <bool> focused: root.focused == "devices" && root.row-device == at + 1 && root.row-param == row + 1;
                                                    Text {
                                                        text: param.name;
                                                        color: parent.focused ? Theme.select : Theme.text-2;
                                                        font-size: Theme.t-small;
                                                        width: 84px;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    Slider {
                                                        value: param.value;
                                                        horizontal-stretch: 1;
                                                        bar: true;
                                                        held(on) => {
                                                            root.hold(root.selected, "param", device.id, param.key, on);
                                                        }
                                                        moved(value) => {
                                                            root.set-param(device.id, param.key, value);
                                                        }
                                                        reset => {
                                                            root.reset-param(device.id, param.key);
                                                        }
                                                        changed has-hover => {
                                                            if (self.has-hover) {
                                                                root.hint = "parameter: drag · wheel to nudge · double click to put it back";
                                                            } else if (root.hint == "parameter: drag · wheel to nudge · double click to put it back") {
                                                                root.hint = "";
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: param.text;
                                                        color: Theme.text;
                                                        font-family: Theme.mono;
                                                        font-size: Theme.t-small;
                                                        font-weight: 500;
                                                        width: 62px;
                                                        overflow: elide;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        icon: Icons.ph-chart-line;
                                                        icon-box: 256;
                                                        width: 20px;
                                                        height: 18px;
                                                        y: 2px;
                                                        quiet: true;
                                                        idle-ink: Theme.text-off;
                                                        clicked => {
                                                            root.automate-param(device.id, param.key);
                                                        }
                                                        changed has-hover => {
                                                            if (self.has-hover) {
                                                                root.hint = "automate: show this parameter's lane on the track, to draw how it moves over time";
                                                            } else if (root.hint == "automate: show this parameter's lane on the track, to draw how it moves over time") {
                                                                root.hint = "";
                                                            }
                                                        }
                                                    }
                                                    Button {
                                                        icon: Icons.ph-plugs;
                                                        icon-box: 256;
                                                        width: 20px;
                                                        height: 18px;
                                                        y: 2px;
                                                        quiet: true;
                                                        idle-ink: Theme.text-off;
                                                        clicked => {
                                                            root.command("learn.param " + device.id + " " + param.key);
                                                        }
                                                        changed has-hover => {
                                                            if (self.has-hover) {
                                                                root.hint = "learn: click, then move a knob or fader of a MIDI controller, and it moves this parameter from then on";
                                                            } else if (root.hint == "learn: click, then move a knob or fader of a MIDI controller, and it moves this parameter from then on") {
                                                                root.hint = "";
                                                            }
                                                        }
                                                    }
                                                }
                                                // The rest: found by name, and then shown first.
                                                if device.more > 0: Text {
                                                    text: "and " + device.more + " more parameters: find one by name…";
                                                    color: more-touch.has-hover ? Theme.text : Theme.text-3;
                                                    font-size: Theme.t-small;
                                                    wrap: word-wrap;
                                                    more-touch := TouchArea {
                                                        clicked => {
                                                            root.device-command(device.id, "param");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // The mixer: a strip per track, the master pinned at the right.
        if root.show-mixer: Rectangle {
            // Shorter while the piano roll shares the window.
            height: Roll.open && !Roll.detached ? 250px : 340px;
            background: Theme.surface;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.divider;
            }
            HorizontalLayout {
                padding-top: 1px;
                spacing: 1px;
                ScrollView {
                    horizontal-stretch: 1;
                    content-width: (root.tracks.length - 1) * 73px;
                    content-height: self.visible-height;
                    for track[index] in root.tracks: MixerStrip {
                        x: index * 73px;
                        y: 0;
                        width: 72px;
                        height: parent.height;
                        visible: !track.master;
                        track: track;
                        chosen: track.id == root.selected;
                        select => {
                            root.select-track(track.id, root.cursor);
                        }
                        hold(what, on) => {
                            root.hold(track.id, what, 0, "", on);
                        }
                        set-volume(value) => {
                            root.set-volume(track.id, value);
                        }
                        reset-volume => {
                            root.reset-volume(track.id);
                        }
                        set-pan(value) => {
                            root.set-pan(track.id, value);
                        }
                        toggle-flag(flag) => {
                            root.toggle-flag(track.id, flag);
                        }
                        clear-clip => {
                            root.clear-clip(track.id);
                        }
                        pick-device(slot) => {
                            root.pick-device(track.id, slot);
                        }
                        hint(text) => {
                            root.hint = text;
                        }
                    }
                }
                if root.tracks.length > 0: MixerStrip {
                    width: 88px;
                    track: root.tracks[root.tracks.length - 1];
                    chosen: self.track.id == root.selected;
                    select => {
                        root.select-track(self.track.id, root.cursor);
                    }
                    hold(what, on) => {
                        root.hold(self.track.id, what, 0, "", on);
                    }
                    set-volume(value) => {
                        root.set-volume(self.track.id, value);
                    }
                    reset-volume => {
                        root.reset-volume(self.track.id);
                    }
                    set-pan(value) => {
                        root.set-pan(self.track.id, value);
                    }
                    toggle-flag(flag) => {
                        root.toggle-flag(self.track.id, flag);
                    }
                    clear-clip => {
                        root.clear-clip(self.track.id);
                    }
                    pick-device(slot) => {
                        root.pick-device(self.track.id, slot);
                    }
                    hint(text) => {
                        root.hint = text;
                    }
                }
            }
        }

        // The piano roll, for the clip that was double-clicked, unless it
        // has been given a window of its own.
        if Roll.open && !Roll.detached: Rectangle {
            height: root.roll-height;
            PianoRoll { }
            // Its top edge: drag to make it taller or shorter.
            TouchArea {
                y: 0;
                height: 5px;
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        root.roll-height = clamp(root.roll-height - (self.mouse-y - self.pressed-y), 160px, root.height - 220px);
                    }
                }
            }
        }

        // Status: the mode, then the prompt or the last message, or else
        // what the pointer does where it is; then what is half typed.
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        Rectangle {
            height: 22px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: label.preferred-width + 12px;
                        height: 16px;
                        border-radius: 3px;
                        background: Theme.mode-color(root.mode);
                        label := Text {
                            text: root.mode-name;
                            color: Theme.on-hue;
                            font-weight: 600;
                            font-size: Theme.t-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.macro != "": Text {
                    text: "recording @" + root.macro;
                    color: Theme.rec;
                    font-size: Theme.t-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                // A render under way: how far it is, and a way to stop it.
                if root.rendering: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Rendering " + root.render-name + "  " + round(root.render-fraction * 100) + "%";
                        color: Theme.text;
                        font-size: Theme.t-small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 120px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.well;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(root.render-fraction, 0, 1);
                                border-radius: 3px;
                                background: Theme.select;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            height: 18px;
                            label: "Cancel";
                            quiet: true;
                            clicked => {
                                root.command("render.cancel");
                            }
                        }
                    }
                }
                // Waiting for a controller to be moved.
                if root.learning != "": HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "LEARN  move a knob or fader for " + root.learning;
                        color: Theme.rec;
                        font-size: Theme.t-small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            height: 18px;
                            label: "Cancel";
                            quiet: true;
                            clicked => {
                                root.command("learn.cancel");
                            }
                        }
                    }
                }
                Text {
                    text: root.prompt-open ? root.prompt + root.prompt-before + "▏" + root.prompt-after : root.status != "" ? root.status : root.hint != "" ? root.hint : Roll.hint;
                    color: root.prompt-open ? Theme.text : root.status == "" ? Theme.text-2 : root.status-level == 2 ? Theme.error : root.status-level == 1 ? Theme.warn : Theme.text;
                    font-family: root.prompt-open ? Theme.mono : "Inter";
                    font-size: root.prompt-open ? Theme.t-base : Theme.t-small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.pending;
                    color: Theme.select;
                    font-family: Theme.mono;
                    font-size: Theme.t-small;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Text {
                    text: root.focused;
                    color: Theme.text-3;
                    font-size: Theme.t-small;
                    vertical-alignment: center;
                }
            }
        }
    }

    // The keys that can follow a half-typed command.
    if root.hints.length > 0: Rectangle {
        property <int> columns: max(1, floor((root.width - 40px) / 270px));
        property <int> per: Math.ceil(root.hints.length / self.columns);
        x: 8px;
        y: root.height - self.height - 34px;
        width: root.width - 16px;
        height: 34px + self.per * 19px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.card-line;
        background: Theme.card;
        clip: true;
        Text {
            x: 12px;
            y: 7px;
            text: root.hint-title;
            color: Theme.text-2;
            font-size: Theme.t-small;
            font-weight: 600;
        }
        for hint[index] in root.hints: Rectangle {
            x: 12px + floor(index / parent.per) * 270px;
            y: 26px + Math.mod(index, parent.per) * 19px;
            width: 262px;
            height: 19px;
            Text {
                x: 0px;
                width: 62px;
                text: hint.key;
                color: Theme.select;
                font-family: Theme.mono;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                x: 66px;
                width: parent.width - 66px;
                text: hint.desc;
                color: Theme.text;
                overflow: elide;
            }
        }
    }

    // A floating page from the kernel: help, a list, a picker.
    if root.float-open: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => {
                root.feed("<Esc>");
            }
        }
        Rectangle {
            width: min(root.width - 40px, 860px);
            height: min(root.height - 60px, page.preferred-height + 52px);
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            clip: true;
            // Rows of a picker are clicked and scrolled; a double click chooses.
            TouchArea {
                property <length> line-height: page.preferred-height / max(1, root.float-lines);
                property <int> line: floor((self.mouse-y - page.y) / self.line-height) + 1;
                property <int> column: floor((self.mouse-x - page.x) / 7.2px) + 1;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && self.mouse-y >= page.y) {
                        root.float-pointer("down", self.line, self.column);
                    }
                }
                scroll-event(event) => {
                    root.float-pointer(event.delta-y < 0 ? "scroll_down" : "scroll_up", self.line, self.column);
                    accept
                }
            }
            Text {
                x: 14px;
                y: 10px;
                text: root.float-title;
                color: Theme.text;
                font-size: Theme.t-title;
                font-weight: 600;
            }
            page := Text {
                x: 14px;
                y: 36px;
                text: root.float-text;
                color: Theme.text;
                font-family: Theme.mono;
                font-size: 12px;
            }
        }
    }

    // The render dialog: where to, what, and how.
    if root.render-open: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => {
                root.render-open = false;
                keys.focus();
            }
        }
        Rectangle {
            width: min(root.width - 40px, 520px);
            height: render-form.preferred-height;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            // Clicks on the card stay on the card.
            TouchArea { }
            render-form := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Render";
                    color: Theme.text;
                    font-size: Theme.t-title;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 70px;
                        text: root.render-stems ? "Folder" : "File";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.render-path;
                        accepted => {
                            root.start-render();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 70px;
                        text: "Range";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    range-menu := ContextMenuArea {
                        Menu {
                            for choice[at] in root.render-ranges: MenuItem {
                                title: choice.label;
                                checked: at == root.render-range;
                                activated => {
                                    root.render-range = at;
                                }
                            }
                        }
                        Button {
                            label: (root.render-range < root.render-ranges.length ? root.render-ranges[root.render-range].label : "The whole song") + "  ▾";
                            clicked => {
                                range-menu.show({ x: 0, y: self.height + 2px });
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 70px;
                        text: "Format";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    Button {
                        label: "WAV";
                        on: !root.render-flac;
                        clicked => {
                            root.render-flac = false;
                        }
                    }
                    Button {
                        label: "FLAC";
                        on: root.render-flac;
                        clicked => {
                            root.render-flac = true;
                            if (root.render-bits == 32) {
                                root.render-bits = 24;
                            }
                        }
                    }
                    Rectangle {
                        width: 12px;
                    }
                    Button {
                        label: "16 bit";
                        on: root.render-bits == 16;
                        clicked => {
                            root.render-bits = 16;
                        }
                    }
                    Button {
                        label: "24 bit";
                        on: root.render-bits == 24;
                        clicked => {
                            root.render-bits = 24;
                        }
                    }
                    Button {
                        label: "32 float";
                        on: root.render-bits == 32;
                        enabled: !root.render-flac;
                        clicked => {
                            root.render-bits = 32;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 70px;
                        text: "Tail";
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        width: 60px;
                        text <=> root.render-tail;
                    }
                    Text {
                        text: "seconds after the end, for reverbs and delays to ring out";
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 70px;
                    }
                    Button {
                        label: "Normalize to −1 dB";
                        on: root.render-normalize;
                        clicked => {
                            root.render-normalize = !root.render-normalize;
                        }
                    }
                    Button {
                        label: "Dither";
                        on: root.render-dither;
                        enabled: root.render-bits != 32;
                        clicked => {
                            root.render-dither = !root.render-dither;
                        }
                    }
                    Button {
                        label: "Mono";
                        on: root.render-mono;
                        clicked => {
                            root.render-mono = !root.render-mono;
                        }
                    }
                    Button {
                        label: "A file per track";
                        on: root.render-stems;
                        clicked => {
                            root.render-stems = !root.render-stems;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: "Cancel";
                        quiet: true;
                        clicked => {
                            root.render-open = false;
                            keys.focus();
                        }
                    }
                    Button {
                        label: "Render";
                        on: true;
                        clicked => {
                            root.start-render();
                        }
                    }
                }
            }
        }
    }

    // Leaving a project that has changes: save them first?
    if root.closing: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: min(root.width - 40px, 460px);
            height: closing-form.preferred-height;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-line;
            background: Theme.card;
            closing-form := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Save the changes to “" + root.closing-name + "”?";
                    color: Theme.text;
                    font-size: Theme.t-title;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.closing-what == "quit" ? "They are lost if you quit without saving."
                        : root.closing-what == "new" ? "They are lost if you start a new project without saving."
                        : "They are lost if you open another project without saving.";
                    color: Theme.text-2;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        label: "Don't save";
                        clicked => {
                            root.close-choice("discard");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        label: "Cancel";
                        quiet: true;
                        clicked => {
                            root.close-choice("cancel");
                        }
                    }
                    Button {
                        label: "Save";
                        on: true;
                        clicked => {
                            root.close-choice("save");
                        }
                    }
                }
            }
        }
    }
}

// The piano roll in a window of its own.
export component RollWindow inherits Window {
    title: "Notes – " + Roll.title + " (" + Roll.track + ")";
    preferred-width: 1180px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 300px;
    background: Theme.surface;
    default-font-family: "Inter";
    default-font-size: 12px;
    callback key(string, bool, bool, bool);
    public function focus-keys() {
        keys.focus();
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
    }
    VerticalLayout {
        PianoRoll {
            vertical-stretch: 1;
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        Rectangle {
            height: 22px;
            background: Theme.panel;
            Text {
                x: 10px;
                width: parent.width - 20px;
                text: Roll.hint;
                color: Theme.text-2;
                font-size: Theme.t-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
