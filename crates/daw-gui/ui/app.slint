                                height: 5px;
                                mouse-cursor: ns-resize;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        keys.focus();
                                        root.gain-clip = clip.id;
                                        root.gain-ay = self.absolute-position.y + self.mouse-y;
